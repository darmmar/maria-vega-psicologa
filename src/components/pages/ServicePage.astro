---
import Layout from "@/components/layout/Layout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CTASection from "@/components/sections/CTASection.astro";
import ServiceContentSection from "@/components/sections/ServiceContentSection.astro";
import { render } from "astro:content";
import { getServiceBySlug, getServiceIcon } from "@/lib/content/collections";
import { buildServicePageJsonLd } from "@/lib/seo";

// Componentes dinámicos de TinaCMS para el editor de bloques ricos
import BotonCTA from "@/components/cms/BotonCTA.astro";
import Testimonio from "@/components/cms/Testimonio.astro";
import Acordeon from "@/components/cms/Acordeon.astro";
import Alerta from "@/components/cms/Alerta.astro";

interface Props {
  slug: string;
  heroIcon?: string;
  heroLayout?: "split" | "centered";
  standalone?: boolean;
}

const { slug, heroIcon, heroLayout = "split", standalone = true } = Astro.props;

const service = await getServiceBySlug(slug);
if (!service) return Astro.redirect("/404");
const { Content } = await render(service);

const iconName = heroIcon ?? getServiceIcon(slug);
const layoutTitle = service.data.seoTitle ?? service.data.title;
const layoutDescription = service.data.seoDescription ?? service.data.description;
const pageUrl = `/${service.data.slug}`;
const jsonLd = buildServicePageJsonLd({
  title: service.data.title,
  description: service.data.description,
  path: pageUrl,
});

const heroProps = {
  label: "Psicología",
  title: service.data.title,
  description: service.data.description,
  descriptionClass: "text-ink-muted text-xl leading-relaxed",
  layout: heroLayout === "centered" ? ("default" as const) : ("split" as const),
  align: heroLayout === "centered" ? ("center" as const) : ("left" as const),
  maxWidth: "3xl" as const,
  icon: heroLayout === "split" ? iconName : undefined,
};
---

{
  standalone ? (
    <Layout title={layoutTitle} description={layoutDescription} canonical={pageUrl} jsonLd={jsonLd}>
      <PageHero {...heroProps} />

      <ServiceContentSection
        image={service.data.image}
        imageAlt={service.data.imageAlt}
        fallbackAlt={`Ilustración del servicio ${service.data.title}`}
      >
        <Content components={{ BotonCTA, Testimonio, Acordeon, Alerta }} />
      </ServiceContentSection>

      <CTASection ctaLabel={service.data.ctaLabel} ctaHref={service.data.ctaHref} />
    </Layout>
  ) : (
    <>
      <PageHero {...heroProps} />

      <ServiceContentSection
        image={service.data.image}
        imageAlt={service.data.imageAlt}
        fallbackAlt={`Ilustración del servicio ${service.data.title}`}
      >
        <Content components={{ BotonCTA, Testimonio, Acordeon, Alerta }} />
      </ServiceContentSection>
    </>
  )
}
