---
import Layout from "@/components/layout/Layout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CTASection from "@/components/sections/CTASection.astro";
import ServiceContentSection from "@/components/sections/ServiceContentSection.astro";
import { render } from "astro:content";
import { getServiceBySlug } from "@/lib/content/collections";
import { buildServicePageJsonLd } from "@/lib/seo";
import { tinaField } from "@tinacms/astro/tina-field";
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro";

// Componentes dinámicos de TinaCMS para el editor de bloques ricos
import BotonCTA from "@/components/cms/BotonCTA.astro";
import Testimonio from "@/components/cms/Testimonio.astro";
import Acordeon from "@/components/cms/Acordeon.astro";
import Alerta from "@/components/cms/Alerta.astro";

interface Props {
  slug: string;
  heroIcon?: string;
  heroLayout?: "split" | "centered";
  preview?: boolean;
}

const { slug, heroIcon, heroLayout = "split", preview } = Astro.props;
const editing = Boolean(Astro.locals.tinaEdit || preview);

let service = await getServiceBySlug(slug, editing);
if (!service) return Astro.redirect("/404");

const { Content } = await render(service);

const iconName = heroIcon ?? service.data.icon ?? "lucide:leaf";
const layoutTitle = service.data.seoTitle ?? service.data.title;
const layoutDescription = service.data.seoDescription ?? service.data.description;
const pageUrl = `/${service.data.slug}`;

const heroImage = (service.data as any).heroImage || service.data.image;
const heroImageAlt = (service.data as any).heroImageAlt || service.data.imageAlt || service.data.title;
const tinaHeroImageField = (service.data as any).heroImage
  ? tinaField(service.data as any, "heroImage")
  : tinaField(service.data, "image");

const jsonLd = buildServicePageJsonLd({
  title: service.data.title,
  description: service.data.description,
  path: pageUrl,
  image: heroImage,
});

const heroProps = {
  label: service.data.heroLabel?.trim(),
  title: service.data.title,
  description: service.data.description,
  descriptionClass: "text-ink-muted text-xl leading-relaxed",
  layout: heroImage ? ("split" as const) : (heroLayout === "centered" ? ("default" as const) : ("split" as const)),
  align: heroImage ? ("left" as const) : (heroLayout === "centered" ? ("center" as const) : ("left" as const)),
  maxWidth: "3xl" as const,
  icon: heroLayout === "split" ? iconName : undefined,
  image: heroImage,
  imageAlt: heroImageAlt,
  tinaImageField: tinaHeroImageField,
  tinaLabelField: tinaField(service.data, "heroLabel"),
  tinaTitleField: tinaField(service.data, "title"),
  tinaDescriptionField: tinaField(service.data, "description"),
};
---

    <Layout preview={preview} island="service" islandParams={{ slug }} title={layoutTitle} description={layoutDescription} canonical={pageUrl} jsonLd={jsonLd} ogImage={heroImage}>
      <PageHero {...heroProps} />

      <ServiceContentSection
        image={(service.data as any).heroImage ? service.data.image : undefined}
        imageAlt={service.data.imageAlt}
        fallbackAlt={`Ilustración del servicio ${service.data.title}`}
        tinaImageField={tinaField(service.data, "image")}
        tinaBodyField={tinaField(service.data as any, "body")}
      >
        {service.tinaBody ? <TinaMarkdown content={service.tinaBody} components={{ BotonCTA, Testimonio, Acordeon, Alerta }} /> : <Content components={{ BotonCTA, Testimonio, Acordeon, Alerta }} />}
      </ServiceContentSection>

      <CTASection
        title={service.data.ctaTitle}
        description={service.data.ctaDescription}
        ctaLabel={service.data.ctaLabel}
        ctaHref={service.data.ctaHref}
        secondaryCtaLabel={["terapia-online", "terapia-presencial"].includes(slug) ? "Escribir un mensaje" : undefined}
        secondaryCtaHref="/contacto"
        tinaTitleField={tinaField(service.data, "ctaTitle")}
        tinaDescriptionField={tinaField(service.data, "ctaDescription")}
        tinaCtaLabelField={tinaField(service.data, "ctaLabel")}
      />
    </Layout>
