---
interface Props {
  quote: string;
  author: string;
  role?: string;
}

const { quote, author, role } = Astro.props;

// Get initials
const initials = author
  ? author
      .split(" ")
      .map((n) => n[0])
      .slice(0, 2)
      .join("")
      .toUpperCase()
  : "T";
---

<div class="my-8 not-prose">
  <div class="relative bg-gradient-to-br from-white/80 to-warm-100/50 backdrop-blur-sm border border-sage/10 p-6 md:p-8 rounded-2xl shadow-premium max-w-2xl mx-auto transition-transform duration-300 hover:scale-[1.01]">
    {/* Decorative Quote Icon */}
    <div class="absolute -top-4 -left-3 text-sage/10 text-7xl font-serif select-none pointer-events-none">
      “
    </div>
    
    <p class="text-ink-muted text-base md:text-lg italic leading-relaxed relative z-10 font-body mb-6">
      "{quote}"
    </p>

    <div class="flex items-center gap-4 border-t border-sage/10 pt-4">
      <div class="w-10 h-10 rounded-full bg-sage-100 text-sage-800 flex items-center justify-center font-bold text-sm">
        {initials}
      </div>
      <div>
        <div class="font-semibold text-ink text-sm md:text-base font-body">{author}</div>
        {role && <div class="text-xs text-ink-faint font-body">{role}</div>}
      </div>
    </div>
  </div>
</div>
