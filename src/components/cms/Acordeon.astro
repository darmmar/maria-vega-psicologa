---
interface Props {
  title: string;
  content: string;
}

const { title, content } = Astro.props;
---

<div class="my-4 not-prose max-w-2xl mx-auto">
  <details class="group bg-white/50 border border-sage/10 rounded-xl overflow-hidden transition-all duration-300 [&_summary::-webkit-details-marker]:hidden">
    <summary class="flex items-center justify-between p-4 cursor-pointer select-none bg-gradient-to-r from-transparent to-warm-50/20 hover:bg-warm-100/40 transition-colors">
      <span class="font-medium text-ink text-sm md:text-base font-body pr-4">
        {title}
      </span>
      <span class="flex-shrink-0 transition-transform duration-300 group-open:rotate-180 text-sage">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg>
      </span>
    </summary>
    <div class="p-4 pt-2 border-t border-sage/5 text-ink-muted text-sm md:text-base font-body leading-relaxed whitespace-pre-line">
      {content}
    </div>
  </details>
</div>
