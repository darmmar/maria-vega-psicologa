---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    "rounded-2xl border border-ink-border/30 bg-white p-6 shadow-premium transition-all duration-300 ease-out",
    "hover:border-sage/20 hover:shadow-premium-hover hover:-translate-y-1",
    className,
  ]}
>
  <slot />
</div>

