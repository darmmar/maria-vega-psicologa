---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    "rounded-2xl border border-ink-border/50 bg-white p-6 transition-all duration-200",
    "hover:border-sage-200 hover:shadow-[0_8px_32px_rgba(71,91,76,0.08)]",
    className,
  ]}
>
  <slot />
</div>
