---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "blush";
  size?: "sm" | "md" | "lg";
  external?: boolean;
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center gap-2 font-body font-medium rounded-lg transition-all duration-300 focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2";

const variantClasses = {
  primary: "bg-sage text-white hover:bg-sage-600 hover:shadow-premium hover:-translate-y-0.5 active:translate-y-0 active:shadow-none",
  secondary: "border border-sage/30 text-sage bg-transparent hover:border-sage hover:bg-sage/5 hover:-translate-y-0.5 active:translate-y-0",
  blush: "bg-blush text-white hover:bg-blush-600 hover:shadow-premium hover:-translate-y-0.5 active:translate-y-0 active:shadow-none",
  ghost: "text-sage hover:bg-sage/5 active:bg-sage/10",
};

const sizeClasses = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg",
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className]
  .filter(Boolean)
  .join(" ");

const externalProps = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

{
  href ? (
    <a href={href} class={classes} {...externalProps} {...rest}>
      <slot />
      {external && (
        <span aria-hidden="true" class="text-sm transition-transform duration-200 group-hover:translate-x-0.5">
          ↗
        </span>
      )}
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}

