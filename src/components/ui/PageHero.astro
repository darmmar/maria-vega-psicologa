---
import Container from "@/components/ui/Container.astro";
import { Icon } from "astro-icon/components";

interface Props {
  label?: string;
  title: string;
  description?: string;
  align?: "center" | "left";
  maxWidth?: "2xl" | "3xl" | "4xl";
  layout?: "default" | "split";
  icon?: string;
  class?: string;
  descriptionClass?: string;
}

const {
  label,
  title,
  description,
  align = "center",
  maxWidth = "2xl",
  layout = "default",
  icon,
  class: className = "",
  descriptionClass = "text-ink-muted text-lg leading-relaxed font-body",
} = Astro.props;

const widthClass = {
  "2xl": "max-w-2xl",
  "3xl": "max-w-3xl",
  "4xl": "max-w-4xl",
  }[maxWidth];

const alignClass = align === "center" ? "mx-auto text-center" : "";
---

<section class:list={["section-hero bg-warm-200 border-b border-warm-300 overflow-hidden relative", className]}>
  
  <Container class="relative">
    {
      layout === "split" ? (
        <div class="grid md:grid-cols-2 gap-8 items-center animate-fade-in-up">
          <div>
            {label && <p class="label-caps text-sage mb-3 animate-fade-in">{label}</p>}
            <h1 class="font-display text-4xl lg:text-5xl font-medium text-ink mb-4 leading-tight">
              {title}
            </h1>
            {description && <p class={descriptionClass}>{description}</p>}
            <slot />
          </div>
          {icon && (
            <div class="hidden md:flex justify-end animate-fade-in" aria-hidden="true">
              <Icon name={icon} class="w-40 h-40 text-sage opacity-10" />
            </div>
          )}
        </div>
      ) : (
        <div class:list={[widthClass, alignClass, "animate-fade-in-up"]}>
          {label && <p class="label-caps text-sage mb-3 animate-fade-in">{label}</p>}
          <h1 class="font-display text-4xl lg:text-5xl font-medium text-ink mb-5 leading-tight">
            {title}
          </h1>
          {description && <p class={descriptionClass}>{description}</p>}
          <slot />
        </div>
      )
    }
  </Container>
</section>

