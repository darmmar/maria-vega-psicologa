---
import Container from "@/components/ui/Container.astro";
import DynamicIcon from "@/components/ui/DynamicIcon.astro";
import { imageSrc } from "@/lib/images";

interface Props {
  label?: string | null;
  title: string;
  description?: string | null;
  align?: "center" | "left";
  maxWidth?: "2xl" | "3xl" | "4xl";
  layout?: "default" | "split";
  icon?: string | null;
  image?: string | null;
  imageAlt?: string | null;
  tinaImageField?: string;
  class?: string;
  descriptionClass?: string;
  tinaLabelField?: string;
  tinaTitleField?: string;
  tinaDescriptionField?: string;
}

const {
  label,
  title,
  description,
  align = "center",
  maxWidth = "2xl",
  layout = "default",
  icon,
  image,
  imageAlt,
  tinaImageField,
  class: className = "",
  descriptionClass = "text-ink-muted text-lg leading-relaxed font-body",
  tinaLabelField,
  tinaTitleField,
  tinaDescriptionField,
} = Astro.props;

const resolvedImage = imageSrc(image);
const hasImage = Boolean(resolvedImage);
const hasIcon = Boolean(icon);
const isSplit = hasImage || (layout === "split" && hasIcon);

const widthClass = {
  "2xl": "max-w-2xl",
  "3xl": "max-w-3xl",
  "4xl": "max-w-4xl",
}[maxWidth];

const alignClass = !isSplit && align === "center" ? "mx-auto text-center" : "";

const isDuplicateLabel = Boolean(
  label && title && label.trim().toLowerCase() === title.trim().toLowerCase()
);
const showLabel = Boolean((label && !isDuplicateLabel) || tinaLabelField);
---

<section class:list={["section-hero bg-warm-200 border-b border-ink-border/40 overflow-hidden relative", className]}>
  <Container class="relative">
    {
      hasImage ? (
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center animate-fade-in-up">
          <div class="lg:col-span-7">
            {showLabel && <p class="label-caps text-sage mb-3 animate-fade-in" data-tina-field={tinaLabelField}>{label}</p>}
            <h1 class="font-display text-4xl lg:text-5xl font-normal text-ink mb-4 leading-tight" data-tina-field={tinaTitleField}>
              {title}
            </h1>
            {(description || tinaDescriptionField) && <p class={descriptionClass} data-tina-field={tinaDescriptionField}>{description}</p>}
            <slot />
          </div>
          <div class="lg:col-span-5 relative w-full max-w-lg mx-auto lg:max-w-none animate-fade-in" data-tina-field={tinaImageField}>
            <div class="relative overflow-hidden rounded-3xl border border-ink-border/30 shadow-premium aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/3] bg-warm-100 group">
              <img
                src={resolvedImage}
                alt={imageAlt?.trim() || title}
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-102"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="640"
                height="480"
              />
            </div>
            <div class="absolute -bottom-3 -right-3 w-24 h-24 rounded-full bg-sage/15 -z-10 blur-xl pointer-events-none"></div>
          </div>
        </div>
      ) : isSplit && hasIcon ? (
        <div class="grid md:grid-cols-12 gap-8 items-center animate-fade-in-up">
          <div class="md:col-span-8 lg:col-span-8">
            {showLabel && <p class="label-caps text-sage mb-3 animate-fade-in" data-tina-field={tinaLabelField}>{label}</p>}
            <h1 class="font-display text-4xl lg:text-5xl font-normal text-ink mb-4 leading-tight" data-tina-field={tinaTitleField}>
              {title}
            </h1>
            {(description || tinaDescriptionField) && <p class={descriptionClass} data-tina-field={tinaDescriptionField}>{description}</p>}
            <slot />
          </div>
          <div class="hidden md:flex md:col-span-4 lg:col-span-4 justify-end animate-fade-in" aria-hidden="true">
            <DynamicIcon name={icon!} class="w-40 h-40 text-sage opacity-10" />
          </div>
        </div>
      ) : (
        <div class:list={[widthClass, alignClass, "animate-fade-in-up"]}>
          {showLabel && <p class="label-caps text-sage mb-3 animate-fade-in" data-tina-field={tinaLabelField}>{label}</p>}
          <h1 class="font-display text-4xl lg:text-5xl font-normal text-ink mb-5 leading-tight" data-tina-field={tinaTitleField}>
            {title}
          </h1>
          {(description || tinaDescriptionField) && <p class={descriptionClass} data-tina-field={tinaDescriptionField}>{description}</p>}
          <slot />
        </div>
      )
    }
  </Container>
</section>


