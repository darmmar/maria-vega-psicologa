---
const editing = Boolean(Astro.locals.tinaEdit || Astro.props.preview);
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { Icon } from "astro-icon/components";
import { getPublishedCourses, getSiteSettings } from "@/lib/content/collections";
import { imageSrc } from "@/lib/images";
import { buildBreadcrumbList, buildJsonLdGraph, buildPerson } from "@/lib/seo";
import { tinaField } from "@tinacms/astro/tina-field";

const [settings, courses] = await Promise.all([getSiteSettings(editing, true), getPublishedCourses(editing)]);

const { coursesPage } = settings;

const pageTitle = coursesPage.seoTitle ?? coursesPage.title;
const pageDescription = coursesPage.seoDescription;

const jsonLd = buildJsonLdGraph(
  buildPerson({
    description: pageDescription,
  }),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: "Cursos", url: "/cursos" },
  ]),
);
---

<Layout preview={Astro.props.preview} island="courses"
  title={pageTitle}
  description={pageDescription}
  canonical="/cursos"
  jsonLd={jsonLd}
  ogImage={coursesPage.image}
>
  <PageHero
    label={coursesPage.label}
    title={coursesPage.title}
    description={coursesPage.intro}
    image={coursesPage.image}
    imageAlt={coursesPage.imageAlt || coursesPage.title}
    tinaImageField={tinaField(coursesPage, "image")}
    tinaLabelField={tinaField(coursesPage, "label")}
    tinaTitleField={tinaField(coursesPage, "title")}
    tinaDescriptionField={tinaField(coursesPage, "intro")}
  />

  <section class="section-gap">
    <Container>
      {
        courses.length > 0 ? (
          <div class="grid sm:grid-cols-2 gap-6 max-w-4xl mx-auto animate-fade-in-up">
            {courses.map((course) => {
              const href = course.data.slug === "curso-duelo" ? "/curso-duelo" : `/cursos/${course.data.slug}`;
              const image = imageSrc(course.data.image);
              const tinaNode = course.data;
              return (
                <Card class="flex flex-col h-full hover:-translate-y-1 transition-all duration-300">
                  {image ? (
                    <div
                      class="w-full aspect-[16/9] overflow-hidden rounded-lg mb-5 group/course-img relative"
                      data-tina-field={tinaNode ? tinaField(tinaNode, "image") : undefined}
                    >
                      <img
                        src={image}
                        alt={course.data.imageAlt ?? course.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover/course-img:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : editing ? (
                    <div
                      class="flex flex-col items-center justify-center aspect-[16/9] rounded-lg border-2 border-dashed border-sage/30 bg-sage/5 mb-5 p-4 text-center transition-all duration-300 hover:border-sage/60 hover:bg-sage/10 cursor-pointer group/placeholder"
                      data-tina-field={tinaNode ? tinaField(tinaNode, "image") : undefined}
                      role="region"
                      aria-label="Imagen de portada del curso"
                    >
                      <div class="w-10 h-10 rounded-full bg-sage/10 flex items-center justify-center text-sage mb-2 group-hover/placeholder:scale-110 transition-transform">
                        <Icon name="lucide:image-plus" class="w-5 h-5 text-sage" />
                      </div>
                      <span class="text-xs font-medium font-body text-sage-700">Añadir imagen de portada</span>
                      <span class="text-[11px] text-ink-muted/80 font-body mt-0.5">Haz clic para subir o seleccionar en TinaCMS</span>
                    </div>
                  ) : (
                    <div
                      class="flex flex-col items-center justify-center aspect-[16/9] rounded-lg bg-gradient-to-br from-warm-100 to-sage/10 mb-5 p-4 text-center"
                      data-tina-field={tinaNode ? tinaField(tinaNode, "image") : undefined}
                    >
                      <div class="w-12 h-12 rounded-xl bg-sage/10 flex items-center justify-center text-sage mb-2">
                        <Icon name="lucide:graduation-cap" class="w-6 h-6 text-sage" />
                      </div>
                      <span class="text-xs font-display text-ink-muted uppercase tracking-wider">Formación profesional</span>
                    </div>
                  )}
                  <h2
                    class="font-display text-xl font-normal text-ink mb-2"
                    data-tina-field={tinaNode ? tinaField(tinaNode, "title") : undefined}
                  >
                    <a href={href} class="hover:text-sage transition-colors duration-200">
                      {course.data.title}
                    </a>
                  </h2>
                  <p
                    class="text-ink-muted text-sm leading-relaxed flex-1 mb-6 font-body"
                    data-tina-field={tinaNode ? tinaField(tinaNode, "shortDescription") : undefined}
                  >
                    {course.data.shortDescription}
                  </p>
                  <div>
                    <Button href={href} variant="secondary" size="sm">
                      Más información
                    </Button>
                  </div>
                </Card>
              );
            })}
          </div>
        ) : (
          <p class="text-center text-ink-muted py-8 font-body">
            Próximamente nuevas formaciones. Si te interesa, puedes{" "}
            <a href="/contacto" class="text-sage underline underline-offset-4 hover:text-sage-600">
              escribirme
            </a>
            .
          </p>
        )
      }
    </Container>
  </section>
</Layout>
