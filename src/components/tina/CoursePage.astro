---
const editing = Boolean(Astro.locals.tinaEdit || Astro.props.preview);
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CTASection from "@/components/sections/CTASection.astro";
import ProseWrapper from "@/components/ui/ProseWrapper.astro";
import { render } from "astro:content";
import { getCourseBySlug } from "@/lib/content/collections";
import { siteConfig } from "@/lib/config/site";
import { buildBreadcrumbList, buildCourse, buildJsonLdGraph, buildPerson } from "@/lib/seo";
import { tinaField } from "@tinacms/astro/tina-field";
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro";

// Componentes dinámicos de TinaCMS para el editor de bloques ricos
import BotonCTA from "@/components/cms/BotonCTA.astro";
import Testimonio from "@/components/cms/Testimonio.astro";
import Acordeon from "@/components/cms/Acordeon.astro";
import Alerta from "@/components/cms/Alerta.astro";

const course = await getCourseBySlug(Astro.props.slug ?? "curso-duelo", editing);
if (!course) return Astro.redirect("/404");

const rendered = await render(course);
const Content = rendered.Content;

const paymentLink =
  course.data.paymentLink || siteConfig.payments.courseDueloPaymentLink || null;

const pageTitle = course.data.seoTitle ?? course.data.title;
const pageDescription = course.data.seoDescription ?? course.data.description;
const pageUrl = course.data.slug === "curso-duelo" ? "/curso-duelo" : `/cursos/${course.data.slug}`;
const heroLabel = course.data.heroLabel?.trim();
const audienceIntro = course.data.audienceIntro?.trim();

const jsonLd = buildJsonLdGraph(
  buildPerson(),
  buildCourse({
    name: course.data.title,
    description: course.data.description,
    url: pageUrl,
    image: course.data.image,
  }),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: "Cursos", url: "/cursos" },
    { name: course.data.title, url: pageUrl },
  ]),
);
---

<Layout preview={Astro.props.preview} island="course" islandParams={{ slug: course.data.slug }}
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  jsonLd={jsonLd}
  ogImage={course.data.image}
>
  <PageHero
    label={heroLabel}
    title={course.data.title}
    image={course.data.image}
    imageAlt={course.data.imageAlt || course.data.title}
    tinaImageField={tinaField(course.data, "image")}
    tinaLabelField={tinaField(course.data, "heroLabel")}
    tinaTitleField={tinaField(course.data, "title")}
  >
    <p class="text-ink-muted text-lg mb-4 font-body" data-tina-field={tinaField(course.data, "shortDescription")}>{course.data.shortDescription}</p>
    {audienceIntro && (
      <p class="text-ink-muted text-base mb-8 max-w-2xl mx-auto font-body" data-tina-field={tinaField(course.data, "audienceIntro")}>{audienceIntro}</p>
    )}
    <div class="flex gap-4 justify-center flex-wrap">
      {paymentLink ? (
        <Button href={paymentLink} variant="primary" size="lg" external data-tina-field={tinaField(course.data, "ctaLabel")}>
          {course.data.ctaLabel?.trim()}
        </Button>
      ) : (
        <Button href="/contacto" variant="primary" size="lg" data-tina-field={tinaField(course.data, "ctaLabel")}>
          {course.data.ctaLabel?.trim()}
        </Button>
      )}
    </div>
  </PageHero>

  <section class="section-gap-tight">
    <Container>
      <div class="max-w-3xl mx-auto animate-fade-in-up" data-tina-field={tinaField(course.data as any, "body")}>
        <ProseWrapper>
          {course.tinaBody ? <TinaMarkdown content={course.tinaBody} components={{ BotonCTA, Testimonio, Acordeon, Alerta }} /> : <Content components={{ BotonCTA, Testimonio, Acordeon, Alerta }} />}
        </ProseWrapper>
      </div>
    </Container>
  </section>

  <CTASection
    title={(course.data as any).bottomCta?.title}
    description={(course.data as any).bottomCta?.description}
    ctaLabel={(course.data as any).bottomCta?.ctaLabel || course.data.ctaLabel?.trim()}
    ctaHref={(course.data as any).bottomCta?.ctaHref}
    tinaTitleField={tinaField((course.data as any).bottomCta, "title")}
    tinaDescriptionField={tinaField((course.data as any).bottomCta, "description")}
    tinaCtaLabelField={tinaField((course.data as any).bottomCta, "ctaLabel") || tinaField(course.data, "ctaLabel")}
  />
</Layout>
