---
const editing = Boolean(Astro.locals.tinaEdit || Astro.props.preview);
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { getContactPage, getSiteSettings } from "@/lib/content/collections";
import { buildBreadcrumbList, buildJsonLdGraph, buildMedicalBusiness, buildPerson } from "@/lib/seo";
import { Icon } from "astro-icon/components";
import { tinaField } from "@tinacms/astro/tina-field";

const [page, settings] = await Promise.all([
  getContactPage(editing),
  getSiteSettings(),
]);

const { hero, firstConsultation, contactDetails, formSection } = page;
const rawConsent =
  formSection.privacyConsentText ||
  "He leído la política de privacidad y consiento el tratamiento de mis datos para atender mi consulta.";

const mdLinkMatch = rawConsent.match(/\[([^\]]+)\]\(([^)]+)\)/);
let consentBefore = rawConsent;
let consentLinkText = "";
let consentLinkHref = "/legal/privacidad";
let consentAfter = "";

if (mdLinkMatch) {
  const [fullMatch, text, href] = mdLinkMatch;
  const matchIndex = rawConsent.indexOf(fullMatch);
  consentBefore = rawConsent.slice(0, matchIndex);
  consentLinkText = text;
  consentLinkHref = href;
  consentAfter = rawConsent.slice(matchIndex + fullMatch.length);
} else {
  const parts = rawConsent.split(/(política de privacidad)/iu);
  if (parts.length >= 3) {
    consentBefore = parts[0];
    consentLinkText = parts[1];
    consentLinkHref = "/legal/privacidad";
    consentAfter = parts.slice(2).join("");
  }
}
const email = contactDetails.email || settings.contact.email;
const phone = contactDetails.phone || settings.contact.phone;
const whatsapp = contactDetails.whatsapp || settings.contact.whatsapp;
const telegram = settings.contact.telegram;

// Fuente única de verdad (SSOT): dirección y mapa configurados en Ajustes Globales o específicos de la página
const displayAddress = contactDetails.address || settings.legal.address;
const googleMapsEmbedUrl = settings.contact.googleMapsEmbedUrl;
const googleMapsLink =
  settings.contact.googleMapsLink ||
  (displayAddress ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(displayAddress)}` : "");

const mapCardTitle = contactDetails.mapCardTitle;
const mapNote = contactDetails.mapNote;

const pageTitle = page.seoTitle ?? hero.title;
const pageDescription = page.seoDescription ?? hero.intro;

// Datos estructurados (NAP consistente con Schema.org LocalBusiness y Person)
const businessOverrides = {
  address: settings.legal.address,
  phone: settings.contact.phone,
  email: settings.contact.email,
  googleMapsLink: settings.contact.googleMapsLink,
  collegiateNumber: settings.legal.collegiateNumber,
  businessName: settings.legal.businessName,
  instagram: settings.contact.instagram,
  linkedin: settings.contact.linkedin,
};

const jsonLd = buildJsonLdGraph(
  buildMedicalBusiness(businessOverrides),
  buildPerson({ description: pageDescription, overrides: businessOverrides }),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: hero.title, url: "/contacto" },
  ]),
);
---

<Layout preview={Astro.props.preview} island="contact" title={pageTitle} description={pageDescription} canonical="/contacto" jsonLd={jsonLd}>
  <contact-interactions style="display: contents">
  <PageHero
    label={hero.label}
    title={hero.title}
    description={hero.intro}
    maxWidth="4xl"
    tinaLabelField={tinaField(page.hero, "label")}
    tinaTitleField={tinaField(page.hero, "title")}
    tinaDescriptionField={tinaField(page.hero, "intro")}
  />

  <section class="section-gap-tight bg-gradient-to-b from-warm-50/20 to-warm-100/10">
    <Container>
      <div class="max-w-5xl mx-auto animate-fade-in-up">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">

          {/* Columna Izquierda: Aviso de Cita, Datos de Contacto y Mapa */}
          <div class="min-w-0 space-y-6 lg:col-span-5">

            {/* Aviso sutil y directo al calendario de reservas */}
            <div class="p-4 sm:p-5 rounded-2xl bg-sage/5 border border-sage/15 transition-all hover:bg-sage/10">
              <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-xl bg-sage/10 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                  <Icon name="lucide:calendar-check" class="w-4 h-4" />
                </div>
                <div class="space-y-1 text-sm font-body">
                  <p class="font-medium text-ink" data-tina-field={tinaField(page.firstConsultation, "title")}>
                    {firstConsultation?.title}
                  </p>
                  <p class="text-ink-muted text-xs sm:text-sm leading-relaxed">
                    {firstConsultation?.calendarCta?.prefix}
                    <a
                      href={firstConsultation?.calendarCta?.linkHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sage font-semibold underline underline-offset-4 hover:text-sage-700 inline-flex items-center gap-0.5"
                      data-tina-field={tinaField(page.firstConsultation.calendarCta, "linkLabel")}
                    >
                      <span>{firstConsultation?.calendarCta?.linkLabel}</span>
                      <span aria-hidden="true" class="text-xs">↗</span>
                    </a>
                    {firstConsultation?.calendarCta?.suffix}
                  </p>
                </div>
              </div>
            </div>

            {/* Canales de contacto directo con iconos vectoriales limpios */}
            <div class="p-5 sm:p-6 rounded-2xl bg-white border border-ink-border/20 shadow-sm space-y-4">
              <h3 class="font-display text-lg font-normal text-ink" data-tina-field={tinaField(page.contactDetails, "title")}>
                {contactDetails.title}
              </h3>

              <div class="space-y-4">
                {/* Email */}
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                    <Icon name="lucide:mail" class="w-4 h-4" />
                  </div>
                  <div class="min-w-0">
                    <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Email</p>
                    {
                      email ? (
                        <a
                          href={`mailto:${email}`}
                          class="text-ink text-sm hover:text-sage transition-colors font-body font-medium [overflow-wrap:anywhere]"
                          data-tina-field={tinaField(page.contactDetails, "email")}
                        >
                          {email}
                        </a>
                      ) : (
                        <p class="text-ink-muted italic text-sm font-body" data-tina-field={tinaField(page.contactDetails, "email")}>[EMAIL PENDIENTE]</p>
                      )
                    }
                  </div>
                </div>

                {/* WhatsApp */}
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                    <Icon name="simple-icons:whatsapp" class="w-4 h-4" />
                  </div>
                  <div>
                    <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">WhatsApp</p>
                    {
                      whatsapp ? (
                        <a
                          href={whatsapp}
                          class="text-ink text-sm hover:text-sage transition-colors font-body font-medium inline-flex items-center gap-1"
                          target="_blank"
                          rel="noopener noreferrer"
                          data-tina-field={tinaField(page.contactDetails, "whatsapp")}
                        >
                          Escribir por WhatsApp
                          <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5 text-ink-muted" />
                        </a>
                      ) : (
                        <p class="text-ink-muted italic text-sm font-body" data-tina-field={tinaField(page.contactDetails, "whatsapp")}>[WHATSAPP PENDIENTE]</p>
                      )
                    }
                  </div>
                </div>

                {/* Teléfono (si está disponible) */}
                {
                  phone && (
                    <div class="flex items-start gap-3">
                      <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                        <Icon name="lucide:phone" class="w-4 h-4" />
                      </div>
                      <div>
                        <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Teléfono</p>
                        <a
                          href={`tel:${phone.replace(/\s+/g, '')}`}
                          class="text-ink text-sm hover:text-sage transition-colors font-body font-medium"
                          data-tina-field={tinaField(page.contactDetails, "phone")}
                        >
                          {phone}
                        </a>
                      </div>
                    </div>
                  )
                }

                {/* Ubicación */}
                {
                  displayAddress && (
                    <div class="flex items-start gap-3">
                      <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                        <Icon name="lucide:map-pin" class="w-4 h-4" />
                      </div>
                      <div>
                        <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Ubicación</p>
                        <p class="text-ink text-sm font-body font-medium" data-tina-field={tinaField(page.contactDetails, "address")}>
                          {displayAddress}
                        </p>
                      </div>
                    </div>
                  )
                }

                {/* Telegram (si está configurado) */}
                {
                  telegram && (
                    <div class="flex items-start gap-3">
                      <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                        <Icon name="simple-icons:telegram" class="w-4 h-4" />
                      </div>
                      <div>
                        <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Telegram</p>
                        <a
                          href={telegram}
                          class="text-ink text-sm hover:text-sage transition-colors font-body font-medium"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Escribir por Telegram
                        </a>
                      </div>
                    </div>
                  )
                }
              </div>
            </div>

            {/* Mapa interactivo de Google Maps con Doble Clic de Consentimiento (RGPD / AEPD) */}
            {
              googleMapsEmbedUrl && (
                <div class="p-5 sm:p-6 rounded-2xl bg-white border border-ink-border/20 shadow-sm space-y-3">
                  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                    <div class="flex min-w-0 items-center gap-2">
                      <Icon name="lucide:map" class="w-4 h-4 shrink-0 text-sage" />
                      <h4 class="font-display text-base font-normal text-ink" data-tina-field={tinaField(page.contactDetails, "mapCardTitle")}>
                        {mapCardTitle}
                      </h4>
                    </div>
                    {
                      googleMapsLink && (
                        <a
                          href={googleMapsLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex shrink-0 items-center gap-1 text-xs text-sage font-medium hover:text-sage-700 underline underline-offset-2 transition-colors"
                        >
                          <span>Cómo llegar</span>
                          <Icon name="lucide:external-link" class="w-3 h-3 shrink-0" />
                        </a>
                      )
                    }
                  </div>

                  <div
                    id="maps-consent-wrapper"
                    data-embed-url={googleMapsEmbedUrl}
                    class="relative flex min-h-[340px] sm:min-h-[300px] w-full items-center justify-center overflow-hidden rounded-xl border border-ink-border/15 bg-warm-50/50 p-4 sm:p-6 text-center"
                  >
                    <!-- Tarjeta de consentimiento previo (Doble Clic) -->
                    <div id="maps-consent-card" class="mx-auto w-full max-w-xs space-y-3">
                      <div class="w-10 h-10 rounded-xl bg-sage/10 text-sage flex items-center justify-center mx-auto" aria-hidden="true">
                        <Icon name="lucide:map-pin" class="w-5 h-5" />
                      </div>
                      <div class="space-y-1">
                        <p class="font-medium text-ink text-sm font-body">Mapa interactivo</p>
                        <p class="text-xs text-ink-muted leading-relaxed font-body">
                          Para proteger tu privacidad, este mapa se carga bajo demanda. Al activarlo, conectas con Google Maps y aceptas sus cookies.
                        </p>
                      </div>
                      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-2.5 pt-2 w-full max-w-xs mx-auto">
                        <button
                          id="btn-load-map"
                          type="button"
                          class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg bg-sage px-4 py-2.5 text-xs font-medium font-body text-white shadow-soft transition-colors hover:bg-sage-600"
                        >
                          <Icon name="lucide:map" class="w-4 h-4 shrink-0" />
                          <span>Cargar mapa</span>
                        </button>
                        {
                          googleMapsLink && (
                            <a
                              href={googleMapsLink}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-lg border border-ink-border/30 bg-white px-4 py-2.5 text-xs font-medium font-body text-ink transition-colors hover:bg-warm-50"
                            >
                              <span>Abrir fuera</span>
                              <Icon name="lucide:external-link" class="w-3.5 h-3.5 shrink-0 text-ink-muted" />
                            </a>
                          )
                        }
                      </div>
                    </div>

                    <!-- Iframe inyectado dinámicamente -->
                    <div id="maps-iframe-target" class="w-full h-full hidden absolute inset-0"></div>
                  </div>

                  {
                    mapNote && (
                      <p class="text-xs text-ink-muted leading-relaxed font-body" data-tina-field={tinaField(page.contactDetails, "mapNote")}>
                        {mapNote}
                      </p>
                    )
                  }
                </div>
              )
            }

          </div>

          {/* Columna Derecha: Formulario de Mensaje */}
          <div class="min-w-0 lg:col-span-7 p-6 sm:p-8 rounded-2xl bg-white border border-ink-border/20 shadow-premium">
            <h2 class="font-display text-2xl font-normal text-ink mb-6" data-tina-field={tinaField(page.formSection, "title")}>
              {formSection.title}
            </h2>

            <!-- Alerta de éxito -->
            <div id="form-success" class="hidden mb-6 p-4 rounded-xl bg-sage/10 border border-sage/30 text-ink text-sm font-body">
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-sage/20 text-sage flex items-center justify-center flex-shrink-0 mt-0.5">
                  <Icon name="lucide:check" class="w-4 h-4" />
                </div>
                <div>
                  <p class="font-medium text-ink">¡Mensaje enviado correctamente!</p>
                  <p class="text-xs text-ink-muted mt-0.5 leading-relaxed">
                    Muchas gracias por contactar. Te responderé a la mayor brevedad posible.
                  </p>
                </div>
              </div>
            </div>

            <!-- Alerta de error -->
            <div id="form-error" class="hidden mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-body">
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <Icon name="lucide:alert-circle" class="w-4 h-4" />
                </div>
                <div>
                  <p class="font-medium">Error al enviar el mensaje</p>
                  <p id="form-error-message" class="text-xs text-rose-700 mt-0.5 leading-relaxed">
                    Por favor, inténtalo de nuevo o contáctame directamente por email o WhatsApp.
                  </p>
                </div>
              </div>
            </div>

            <form id="contact-form" method="POST" action="/api/contact" class="space-y-5">
              <!-- Honeypot anti-spam invisible para usuarios reales -->
              <div class="hidden" aria-hidden="true">
                <label for="botField">No rellenar</label>
                <input id="botField" name="botField" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div>
                <label for="nombre" class="block text-sm font-medium text-ink mb-1.5 font-body" data-tina-field={tinaField(page.formSection, "nameLabel")}>
                  {formSection.nameLabel}
                </label>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  required
                  autocomplete="name"
                  class="w-full rounded-xl border border-ink-border/30 bg-white px-4 py-3 text-ink placeholder-ink-muted/50 focus:border-sage focus:outline-none focus:ring-4 focus:ring-sage/10 transition-all duration-200 font-body text-sm"
                  placeholder={formSection.namePlaceholder}
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-ink mb-1.5 font-body" data-tina-field={tinaField(page.formSection, "emailLabel")}>
                  {formSection.emailLabel}
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="w-full rounded-xl border border-ink-border/30 bg-white px-4 py-3 text-ink placeholder-ink-muted/50 focus:border-sage focus:outline-none focus:ring-4 focus:ring-sage/10 transition-all duration-200 font-body text-sm"
                  placeholder={formSection.emailPlaceholder}
                />
              </div>

              <div>
                <label for="mensaje" class="block text-sm font-medium text-ink mb-1.5 font-body" data-tina-field={tinaField(page.formSection, "messageLabel")}>
                  {formSection.messageLabel}
                </label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  required
                  rows={5}
                  class="w-full rounded-xl border border-ink-border/30 bg-white px-4 py-3 text-ink placeholder-ink-muted/50 focus:border-sage focus:outline-none focus:ring-4 focus:ring-sage/10 transition-all duration-200 font-body text-sm resize-none"
                  placeholder={formSection.messagePlaceholder}
                ></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input
                  id="privacidad"
                  name="privacidad"
                  type="checkbox"
                  required
                  class="mt-1 h-4 w-4 shrink-0 rounded border-ink-border/40 text-sage focus:ring-sage"
                />
                <label for="privacidad" class="text-sm text-ink-muted leading-relaxed font-body" data-tina-field={tinaField(page.formSection, "privacyConsentText")}>
                  {consentLinkText ? (
                    <>
                      {consentBefore}
                      <a
                        href={consentLinkHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${consentLinkText} (se abre en una pestaña nueva)`}
                        class="text-sage underline underline-offset-4 hover:text-sage-600"
                      >
                        {consentLinkText}
                      </a>
                      {consentAfter}
                    </>
                  ) : (
                    rawConsent
                  )}
                </label>
              </div>

              <p class="text-xs text-ink-muted/70 leading-relaxed border-l-2 border-ink-border/20 pl-3 font-body" data-tina-field={tinaField(page.formSection, "privacyNote")}>
                {formSection.privacyNote}
              </p>

              <button
                id="submit-button"
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2 font-body font-medium rounded-lg bg-sage text-white px-6 py-3.5 text-base hover:bg-sage-600 hover:shadow-premium hover:-translate-y-0.5 active:translate-y-0 active:shadow-none transition-all duration-300 ease-out focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span id="submit-text" data-original-text={formSection.submitLabel} data-tina-field={tinaField(page.formSection, "submitLabel")}>
                  {formSection.submitLabel}
                </span>
                <span id="submit-spinner" class="hidden">
                  <Icon name="lucide:loader-2" class="w-5 h-5 animate-spin" />
                </span>
              </button>
            </form>
          </div>

        </div>
      </div>
    </Container>
  </section>

  </contact-interactions>
  <script is:inline>
  if (!customElements.get("contact-interactions")) {
    customElements.define("contact-interactions", class extends HTMLElement {
      connectedCallback() {
        const root = this;
    // Gestión de carga interactiva de mapa (Consentimiento Doble Clic)
    (function initMapsConsent() {
      const wrapper = root.querySelector("#maps-consent-wrapper");
      const loadBtn = root.querySelector("#btn-load-map");
      const card = root.querySelector("#maps-consent-card");
      const target = root.querySelector("#maps-iframe-target");

      if (!wrapper || !loadBtn || !card || !target) return;

      const embedUrl = wrapper.getAttribute("data-embed-url");

      function renderMap() {
        if (!embedUrl || target.querySelector("iframe")) return;
        const iframe = document.createElement("iframe");
        iframe.src = embedUrl;
        iframe.width = "100%";
        iframe.height = "100%";
        iframe.style.border = "0";
        iframe.allowFullscreen = true;
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        iframe.className = "w-full h-full";
        iframe.title = "Ubicación de la consulta presencial";

        target.replaceChildren(iframe);
        card.classList.add("hidden");
        target.classList.remove("hidden");
      }

      try {
        if (sessionStorage.getItem("consent_google_maps") === "true") {
          renderMap();
        }
      } catch (_) {}

      loadBtn.addEventListener("click", () => {
        try {
          sessionStorage.setItem("consent_google_maps", "true");
        } catch (_) {}
        renderMap();
      });
    })();

    // Envío asíncrono y accesible del formulario de contacto
    (function initContactForm() {
      const form = root.querySelector("#contact-form");
      const successBox = root.querySelector("#form-success");
      const errorBox = root.querySelector("#form-error");
      const errorMessage = root.querySelector("#form-error-message");
      const submitBtn = root.querySelector("#submit-button");
      const submitText = root.querySelector("#submit-text");
      const submitSpinner = root.querySelector("#submit-spinner");

      if (!form || !submitBtn || !submitText || !submitSpinner) return;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        successBox?.classList.add("hidden");
        errorBox?.classList.add("hidden");

        submitBtn.setAttribute("disabled", "true");
        submitText.textContent = "Enviando mensaje...";
        submitSpinner.classList.remove("hidden");

        const formData = new FormData(form);
        const data = {
          nombre: formData.get("nombre"),
          email: formData.get("email"),
          mensaje: formData.get("mensaje"),
          botField: formData.get("botField"),
        };

        try {
          const response = await fetch(form.action || "/api/contact", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(data),
          });

          const result = await response.json().catch(() => ({}));

          if (response.ok && result.success) {
            form.reset();
            successBox?.classList.remove("hidden");
            successBox?.scrollIntoView({ behavior: "smooth", block: "nearest" });
          } else {
            if (errorMessage) {
              errorMessage.textContent =
                result.error || "No se pudo enviar el mensaje. Por favor, inténtalo de nuevo.";
            }
            errorBox?.classList.remove("hidden");
          }
        } catch {
          if (errorMessage) {
            errorMessage.textContent =
              "Ocurrió un fallo de conexión. Por favor, compruébalo o contáctame por WhatsApp o email.";
          }
          errorBox?.classList.remove("hidden");
        } finally {
          submitBtn.removeAttribute("disabled");
          submitText.textContent = submitText.getAttribute("data-original-text") || "Enviar mensaje";
          submitSpinner.classList.add("hidden");
        }
      });
    })();
      }
    });
  }
  </script>
</Layout>
