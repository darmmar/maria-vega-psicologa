---
const editing = Boolean(Astro.locals.tinaEdit || Astro.props.preview);
import Layout from '@/components/layout/Layout.astro'
import Container from '@/components/ui/Container.astro'
import Badge from '@/components/ui/Badge.astro'
import PageHero from '@/components/ui/PageHero.astro'
import { getPublishedResources, getSiteSettings } from '@/lib/content/collections'
import { imageSrc } from '@/lib/images'
import { buildBreadcrumbList, buildJsonLdGraph, buildPerson } from '@/lib/seo'
import { tinaField } from '@tinacms/astro/tina-field'

const [settings, resources] = await Promise.all([
  getSiteSettings(editing, true),
  getPublishedResources(editing),
]);

const resourcesPage = {
  label: settings.resourcesPage?.label,
  title: settings.resourcesPage?.title,
  intro: settings.resourcesPage?.intro,
  image: settings.resourcesPage?.image || undefined,
  imageAlt: settings.resourcesPage?.imageAlt,
  seoTitle: settings.resourcesPage?.seoTitle,
  seoDescription: settings.resourcesPage?.seoDescription,
};

const pageTitle = resourcesPage.seoTitle ?? resourcesPage.title ?? "";
const pageDescription = resourcesPage.seoDescription ?? "";
const heroTitle = resourcesPage.title ?? "";

const jsonLd = buildJsonLdGraph(
  buildPerson(),
  {
    "@type": "CollectionPage",
    name: heroTitle,
    description: pageDescription,
    url: "/recursos",
    inLanguage: "es-ES",
  },
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: heroTitle, url: "/recursos" },
  ])
);
---

<Layout preview={Astro.props.preview} island="resources"
  title={pageTitle}
  description={pageDescription}
  canonical="/recursos"
  jsonLd={jsonLd}
  ogImage={resourcesPage.image}
>
  <PageHero
    label={resourcesPage.label}
    title={heroTitle}
    description={resourcesPage.intro}
    image={resourcesPage.image}
    imageAlt={resourcesPage.imageAlt || heroTitle}
    tinaImageField={tinaField(settings.resourcesPage, 'image')}
    tinaLabelField={tinaField(settings.resourcesPage, 'label')}
    tinaTitleField={tinaField(settings.resourcesPage, 'title')}
    tinaDescriptionField={tinaField(settings.resourcesPage, 'intro')}
  />

  <section class="section-gap-tight">
    <Container>
      {resources.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in-up">
          {resources.map((r) => {
            const tinaNode = r.data;
            return (
              <a
                href={`/recursos/${r.data.slug}`}
                aria-label={`Leer artículo: ${r.data.title}`}
                class="group block p-6 bg-white rounded-2xl border border-ink-border/30 shadow-premium hover:border-sage/20 hover:shadow-premium-hover hover:-translate-y-1 transition-all duration-300 ease-out flex flex-col justify-between"
                data-tina-field={tinaNode ? tinaField(tinaNode, 'title') : undefined}
              >
                <div>
                  {r.data.image && (
                    <div class="w-full aspect-[16/10] overflow-hidden rounded-xl mb-4 bg-warm-100" data-tina-field={tinaNode ? tinaField(tinaNode, "image") : undefined}>
                      <img
                        src={imageSrc(r.data.image)}
                        alt={r.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-102"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                  {r.data.tags.length > 0 && (
                    <div class="mb-3" data-tina-field={tinaNode ? tinaField(tinaNode, 'tags') : undefined}>
                      <Badge variant="blush">{r.data.tags[0]}</Badge>
                    </div>
                  )}
                  <h2
                    class="font-display text-xl font-normal text-ink mb-2 line-clamp-2 h-14 leading-snug group-hover:text-sage transition-colors duration-200"
                    data-tina-field={tinaNode ? tinaField(tinaNode, 'title') : undefined}
                  >
                    {r.data.title}
                  </h2>
                  <p
                    class="text-ink-muted text-sm mb-4 font-body line-clamp-3"
                    data-tina-field={tinaNode ? tinaField(tinaNode, 'description') : undefined}
                  >
                    {r.data.description}
                  </p>
                </div>

                <div class="pt-3 border-t border-ink-border/10">
                  <span class="text-sage font-medium text-sm group-hover:underline underline-offset-4 font-body inline-flex items-center gap-1">
                    Leer artículo <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-center text-ink-muted py-12 font-body">Próximamente recursos psicoeducativos.</p>
      )}
    </Container>
  </section>
</Layout>
