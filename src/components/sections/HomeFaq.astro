---
import Container from "@/components/ui/Container.astro";
import { Icon } from "astro-icon/components";

interface Props {
  items: any[];
  label?: string;
  title?: string;
  description?: string;
  tinaLabelField?: string;
  tinaTitleField?: string;
  tinaDescriptionField?: string;
}

const {
  items,
  label = "Preguntas frecuentes",
  title = "Respuestas sobre el proceso de terapia",
  description = "Resolver tus dudas antes de comenzar es fundamental para dar el paso con tranquilidad y confianza.",
  tinaLabelField,
  tinaTitleField,
  tinaDescriptionField,
} = Astro.props;
---

<section class="section-gap bg-gradient-to-b from-warm-100/40 to-warm-200/50 border-t border-ink-border/10">
  <Container>
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10 md:mb-12">
        <span class="label-caps text-sage block mb-3" data-tina-field={tinaLabelField}>{label}</span>
        <h2 class="font-display text-3xl md:text-4xl font-normal text-ink leading-tight mb-4" data-tina-field={tinaTitleField}>
          {title}
        </h2>
        <p class="text-ink-muted text-base md:text-lg max-w-xl mx-auto font-body" data-tina-field={tinaDescriptionField}>
          {description}
        </p>
      </div>

      <div class="space-y-4">
        {items.map((item) => (
          <details name="home-faq" class="group bg-white rounded-2xl border border-ink-border/20 shadow-premium overflow-hidden" data-tina-field={item.tinaFieldItem}>
            <summary class="flex justify-between items-center px-6 py-5 cursor-pointer list-none font-body font-medium text-ink hover:text-sage [&::-webkit-details-marker]:hidden">
              <span class="text-base pr-4 leading-snug" data-tina-field={item.tinaFieldQuestion}>{item.question}</span>
              <span class="w-8 h-8 rounded-full bg-sage/5 flex items-center justify-center text-sage shrink-0 transition-transform group-open:rotate-180">
                <Icon name="lucide:chevron-down" class="w-4 h-4" aria-hidden="true" />
              </span>
            </summary>
            <div class="px-6 pb-6 text-ink-muted text-base leading-relaxed font-body" data-tina-field={item.tinaFieldAnswer}>{item.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </Container>
</section>
