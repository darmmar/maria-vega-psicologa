---
import Container from "@/components/ui/Container.astro";
import FAQAccordion from "@/components/islands/FAQAccordion";
import type { FaqItem } from "@/lib/seo";

interface Props {
  items: FaqItem[];
  title?: string;
  description?: string;
}

const {
  items,
  title = "Respuestas sobre el proceso de terapia",
  description = "Resolver tus dudas antes de comenzar es fundamental para dar el paso con tranquilidad y confianza.",
} = Astro.props;
---

<section class="section-gap bg-gradient-to-b from-warm-100/40 to-warm-200/50 border-t border-ink-border/10">
  <Container>
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10 md:mb-12">
        <span class="label-caps text-sage block mb-3">Preguntas frecuentes</span>
        <h2 class="font-display text-3xl md:text-4xl font-normal text-ink leading-tight mb-4">
          {title}
        </h2>
        <p class="text-ink-muted text-base md:text-lg max-w-xl mx-auto font-body">
          {description}
        </p>
      </div>

      <FAQAccordion items={items} client:visible />
    </div>
  </Container>
</section>
