---
import Container from "@/components/ui/Container.astro";
import { Icon } from "astro-icon/components";
import { getSiteSettings, getPublishedExperience } from "@/lib/content/collections";

const settings = await getSiteSettings();
const { experienceSection } = settings;

const experienceItems = await getPublishedExperience();
---

<section class="section-gap bg-gradient-to-b from-warm-200 to-warm-300/30">
  <Container>
    <span class="label-caps text-sage block mb-4">{experienceSection.label}</span>
    <h2 class="font-display text-3xl lg:text-4xl font-normal text-ink mb-10 leading-tight">
      {experienceSection.title}
    </h2>

    <div class="grid sm:grid-cols-2 gap-5 max-w-4xl">
      {
        experienceItems.map((item) => (
          <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white border border-ink-border/30 shadow-premium transition-all duration-300 hover:border-sage/20 hover:shadow-premium-hover hover:-translate-y-0.5">
            <Icon name="lucide:check-circle" class="w-5 h-5 text-sage flex-shrink-0 mt-0.5" aria-hidden="true" />
            <span class="text-base text-ink-muted leading-relaxed font-body">{item.data.area}</span>
          </div>
        ))
      }
    </div>
  </Container>
</section>

