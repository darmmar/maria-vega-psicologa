---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title?: string;
  description?: string;
  ctaHref?: string;
  ctaLabel?: string;
  label?: string;
}

const {
  title = "Formación clínica en duelo",
  description = "Formación profesional para psicólogos/as y profesionales de la salud mental que quieren adquirir destrezas para acompañar el duelo en consulta.",
  ctaHref = "/cursos",
  ctaLabel = "Solicitar información",
  label = "Formación profesional",
} = Astro.props;
---

<section class="section-gap bg-gradient-to-r from-warm-200 to-warm-100/40 border-y border-ink-border/10 relative overflow-hidden">
  <div class="absolute -right-24 -bottom-24 w-72 h-72 bg-blush-100/20 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>
  <Container class="relative">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
      <div class="max-w-2xl">
        <span class="label-caps text-sage block mb-4">{label}</span>
        <h2 class="font-display text-3xl lg:text-4xl font-normal text-ink mb-5 leading-tight">
          {title}
        </h2>
        <p class="text-lg text-ink-muted leading-relaxed mb-8 font-body">
          {description}
        </p>
        <Button href={ctaHref} variant="primary" size="lg">{ctaLabel}</Button>
      </div>

      <div class="hidden lg:block flex-shrink-0 text-sage/10" aria-hidden="true">
        <Icon name="lucide:graduation-cap" class="w-44 h-44" />
      </div>
    </div>
  </Container>
</section>

