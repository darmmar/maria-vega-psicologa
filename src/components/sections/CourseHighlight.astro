---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";

interface Props {
  title?: string;
  description?: string;
  ctaHref?: string;
}

const {
  title = "Curso de duelo",
  description = "Un espacio de acompañamiento para transitar la pérdida.",
  ctaHref = "/curso-duelo",
} = Astro.props;
---

<section class="section-gap bg-warm-400 border-y border-sage-200/50">
  <Container>
    <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
      <!-- Text content -->
      <div class="max-w-xl">
        <span class="label-caps text-sage block mb-5">Programa grupal</span>
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink mb-5 leading-tight">
          {title}
        </h2>
        <p class="text-lg text-ink-muted leading-relaxed mb-8">
          {description}
        </p>
        <Button href={ctaHref} variant="primary">Más información</Button>
      </div>

      <!-- Decorative organic shape -->
      <div class="hidden lg:block flex-shrink-0 relative" aria-hidden="true">
        <div class="w-52 h-52 rounded-full bg-sage-100/80"></div>
        <div class="absolute -bottom-4 -right-4 w-24 h-24 rounded-full bg-warm-600/30"></div>
      </div>
    </div>
  </Container>
</section>
