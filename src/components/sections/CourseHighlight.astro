---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title?: string;
  description?: string;
  ctaHref?: string;
  ctaLabel?: string;
  label?: string;
}

const {
  title = "Formación clínica en duelo",
  description = "Formación profesional para psicólogos/as y profesionales de la salud mental que quieren adquirir destrezas para acompañar el duelo en consulta.",
  ctaHref = "/cursos",
  ctaLabel = "Solicitar información",
  label = "Formación profesional",
} = Astro.props;
---

<section class="section-gap bg-warm-400 border-y border-sage-200/50">
  <Container>
    <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
      <div class="max-w-xl">
        <span class="label-caps text-sage block mb-5">{label}</span>
        <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink mb-5 leading-tight">
          {title}
        </h2>
        <p class="text-lg text-ink-muted leading-relaxed mb-8">
          {description}
        </p>
        <Button href={ctaHref} variant="primary">{ctaLabel}</Button>
      </div>

      <div class="hidden lg:block flex-shrink-0" aria-hidden="true">
        <Icon name="lucide:graduation-cap" class="w-40 h-40 text-sage opacity-15" />
      </div>
    </div>
  </Container>
</section>
