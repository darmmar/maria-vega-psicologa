---
import Container from "@/components/ui/Container.astro";
import { Icon } from "astro-icon/components";

interface TrainingItem {
  degree: string;
  institution: string;
  year?: string;
}

const clinical: TrainingItem[] = [
  {
    degree: "Máster en Psicología General Sanitaria",
    institution: "Universidad de Málaga",
    year: "2024",
  },
  {
    degree: "Máster en Terapias Contextuales y de Tercera Generación",
    institution: "UDIMA",
  },
];

const complementary: TrainingItem[] = [
  {
    degree: "Máster en Dirección y Gestión de Personas",
    institution: "VIU",
  },
  {
    degree: "Orientadora Laboral",
    institution: "AOSLA-Gizalan",
  },
];
---

<section class="section-gap bg-warm-100">
  <Container>
    <Icon name="lucide:graduation-cap" class="w-10 h-10 text-sage opacity-70 mb-5" aria-hidden="true" />
    <span class="label-caps text-sage block mb-5">Cualificación</span>
    <h2 class="font-display text-3xl lg:text-4xl font-semibold text-ink mb-12 leading-tight">
      Formación
    </h2>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Clinical training -->
      <div>
        <h3 class="font-display text-xl font-medium text-ink mb-7">Formación clínica</h3>
        <div class="space-y-7">
          {
            clinical.map((item) => (
              <div class="border-l-2 border-sage-200 pl-5">
                <p class="font-semibold text-ink leading-snug">{item.degree}</p>
                <p class="text-sm text-ink-muted mt-1">
                  {item.institution}
                  {item.year ? ` · ${item.year}` : ""}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Complementary training -->
      <div>
        <h3 class="font-display text-xl font-medium text-ink-muted mb-7">
          Formación complementaria
        </h3>
        <div class="space-y-7">
          {
            complementary.map((item) => (
              <div class="border-l-2 border-ink-border/60 pl-5">
                <p class="text-ink leading-snug">{item.degree}</p>
                <p class="text-sm text-ink-faint mt-1">{item.institution}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>
