---
import Container from "@/components/ui/Container.astro";
import { Icon } from "astro-icon/components";
import { imageSrc } from "@/lib/images";
import { getServiceIcon } from "@/lib/content/collections";

interface ServiceItem {
  title: string;
  shortDescription: string;
  href: string;
  icon?: string;
  thumbnail?: string;
  thumbnailAlt?: string;
}

interface Props {
  services: ServiceItem[];
  sectionLabel?: string;
  sectionTitle?: string;
}

const {
  services,
  sectionLabel = "Especialidades",
  sectionTitle = "¿En qué puedo ayudarte?",
} = Astro.props;
---

<section class="section-gap bg-gradient-to-b from-warm-100 to-warm-50/10">
  <Container>
    <span class="label-caps text-sage block mb-4">{sectionLabel}</span>
    <h2 class="font-display text-3xl lg:text-4xl font-normal text-ink mb-12 leading-tight">
      {sectionTitle}
    </h2>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => {
          const thumbnailSrc = imageSrc(service.thumbnail);
          const thumbnailAlt =
            service.thumbnailAlt?.trim() || `Miniatura del servicio ${service.title}`;

          return (
            <a
              href={service.href}
              class="group block p-6 bg-gradient-to-b from-white to-warm-50/30 rounded-2xl border border-ink-border/30 border-t-2 border-t-sage/25 shadow-premium hover:border-sage/20 hover:shadow-premium-hover hover:-translate-y-1 transition-all duration-300 ease-out"
            >
              {thumbnailSrc ? (
                <div class="w-full h-32 overflow-hidden rounded-xl mb-5">
                  <img
                    src={thumbnailSrc}
                    alt={thumbnailAlt}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="w-10 h-10 rounded-xl bg-sage/5 flex items-center justify-center mb-5 text-sage transition-colors duration-300">
                  <Icon name={getServiceIcon(service.href)} class="w-5 h-5" />
                </div>
              )}
              <h3 class="font-display text-xl font-normal text-ink mb-2 group-hover:text-sage transition-colors duration-200">
                {service.title}
              </h3>
              <p class="text-sm text-ink-muted leading-relaxed mb-4 font-body">
                {service.shortDescription}
              </p>
              <span class="text-sm font-medium text-sage group-hover:underline underline-offset-4 font-body inline-flex items-center gap-1">
                Saber más <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </Container>
</section>

