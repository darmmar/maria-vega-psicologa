---
import Container from "@/components/ui/Container.astro";
import ProseWrapper from "@/components/ui/ProseWrapper.astro";
import { imageSrc } from "@/lib/images";

interface Props {
  image?: string;
  imageAlt?: string;
  fallbackAlt?: string;
}

const { image, imageAlt, fallbackAlt = "Ilustración del servicio" } = Astro.props;
const src = imageSrc(image);
const alt = imageAlt?.trim() || fallbackAlt;
---

<section class="section-gap-tight bg-gradient-to-b from-warm-50/20 to-warm-100/10">
  <Container>
    {
      src ? (
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
          <div class="lg:col-span-7">
            <ProseWrapper>
              <slot />
            </ProseWrapper>
          </div>
          <div class="lg:col-span-5 lg:sticky lg:top-24">
            <figure class="relative group">
              <img
                src={src}
                alt={alt}
                class="w-full rounded-3xl border border-ink-border/20 shadow-premium-hover object-cover aspect-[4/3] sm:aspect-[4/5] transition-transform duration-500 hover:scale-[1.01]"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute -bottom-4 -left-4 w-16 h-16 rounded-full bg-blush/10 -z-10 blur-sm"></div>
            </figure>
          </div>
        </div>
      ) : (
        <div class="max-w-4xl mx-auto">
          <ProseWrapper>
            <slot />
          </ProseWrapper>
        </div>
      )
    }
  </Container>
</section>

