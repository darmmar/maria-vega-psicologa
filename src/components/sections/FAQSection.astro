---
import Container from "@/components/ui/Container.astro";
import FAQAccordion from "@/components/islands/FAQAccordion";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
}

const { items, title = "Preguntas frecuentes" } = Astro.props;
---

<section class="section-gap bg-gradient-to-b from-warm-200 to-warm-100/60">
  <Container>
    <div class="max-w-3xl mx-auto">
      <span class="label-caps text-sage block mb-4">FAQ</span>
      <h2 class="font-display text-3xl lg:text-4xl font-normal text-ink mb-10 leading-tight">
        {title}
      </h2>

      {
        items && items.length > 0 ? (
          <FAQAccordion items={items} client:visible />
        ) : (
          <p class="text-ink-muted text-base leading-relaxed font-body">
            Próximamente encontrarás respuestas a las preguntas más frecuentes sobre terapia,
            primeras sesiones y proceso de trabajo.
          </p>
        )
      }
    </div>
  </Container>
</section>

