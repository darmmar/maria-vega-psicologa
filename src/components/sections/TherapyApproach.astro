---
import Container from "@/components/ui/Container.astro";
import { Icon } from "astro-icon/components";
import { getSiteSettings } from "@/lib/content/collections";
import { tinaField } from "@tinacms/astro";

interface Props {
  therapyApproach?: any;
}

const propsApproach = Astro.props.therapyApproach;
const approachData = propsApproach ?? (await getSiteSettings()).therapyApproach;
---

<section class="section-gap bg-gradient-to-b from-warm-200 to-warm-100/50">
  <Container>
    <div class="max-w-4xl mx-auto">
      <span class="label-caps text-sage block mb-4" data-tina-field={tinaField(approachData, "label")}>
        {approachData.label}
      </span>
      <h2 class="font-display text-3xl lg:text-4xl font-normal text-ink mb-6 leading-tight" data-tina-field={tinaField(approachData, "title")}>
        {approachData.title}
      </h2>
      <p class="text-lg text-ink-muted leading-relaxed mb-12 max-w-3xl font-body" data-tina-field={tinaField(approachData, "description")}>
        {approachData.description}
      </p>

      <div class="grid md:grid-cols-3 gap-6">
        {
          approachData.pillars?.map((pillar: any, index: number) => (
            <div
              class="p-6 rounded-2xl bg-gradient-to-b from-white to-warm-50/30 border border-ink-border/30 border-t-2 border-t-sage/25 shadow-premium transition-all duration-300 hover:border-sage/20 hover:shadow-premium-hover hover:-translate-y-1"
              data-tina-field={tinaField(approachData, "pillars", index)}
            >
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-sage/5 to-sage/15 border border-sage/10 flex items-center justify-center mb-5 text-sage transition-colors duration-300">
                <Icon name={pillar.icon} class="w-6 h-6" />
              </div>
              <h3 class="font-display text-xl font-normal text-ink mb-2" data-tina-field={tinaField(pillar, "title")}>
                {pillar.title}
              </h3>
              <p class="text-sm text-ink-muted leading-relaxed font-body" data-tina-field={tinaField(pillar, "description")}>
                {pillar.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>

