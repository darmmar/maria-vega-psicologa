---
import Container from "@/components/ui/Container.astro";

interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = "¿Hablamos?",
  description = "El primer paso es contactar. Sin compromiso.",
  ctaLabel = "Reservar cita",
  ctaHref = "/reserva",
} = Astro.props;
---

<section class="section-gap bg-sage">
  <Container>
    <div class="max-w-2xl mx-auto text-center space-y-6">
      <h2 class="font-display text-3xl lg:text-4xl font-semibold text-white leading-tight">
        {title}
      </h2>
      <p class="text-lg text-sage-100 leading-relaxed">
        {description}
      </p>
      <div class="pt-2">
        <a
          href={ctaHref}
          class="inline-flex items-center gap-2 font-body font-semibold rounded-full border-2 border-white/70 text-white px-8 py-4 text-base hover:border-white hover:bg-white/10 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-sage"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </Container>
</section>
