---
import Container from "@/components/ui/Container.astro";

interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  tinaTitleField?: string;
  tinaDescriptionField?: string;
  tinaCtaLabelField?: string;
}

const {
  title = "¿Hablamos?",
  description = "El primer paso es contactar. Sin compromiso.",
  ctaLabel = "Contactar",
  ctaHref = "/contacto",
  secondaryCtaLabel,
  secondaryCtaHref,
  tinaTitleField,
  tinaDescriptionField,
  tinaCtaLabelField,
} = Astro.props;

const isExternal = ctaHref.startsWith("http");
---

<section class="section-gap bg-gradient-to-br from-sage to-sage-700 relative overflow-hidden">
  <!-- Glowing subtle accents -->
  <div class="absolute -top-32 -left-32 w-80 h-80 rounded-full bg-white/5 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-32 -right-32 w-80 h-80 rounded-full bg-blush-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
  
  <Container class="relative">
    <div class="max-w-2xl mx-auto text-center space-y-6">
      <h2 class="font-display text-3xl lg:text-4xl font-normal text-white leading-tight" data-tina-field={tinaTitleField}>
        {title}
      </h2>
      <p class="text-lg text-sage-50 leading-relaxed font-body" data-tina-field={tinaDescriptionField}>
        {description}
      </p>
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={ctaHref}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 font-body font-medium rounded-full bg-white border border-sage-100/50 text-sage px-8 py-3.5 text-base hover:bg-warm-50 hover:shadow-premium hover:-translate-y-0.5 active:translate-y-0 active:shadow-none transition-all duration-300 ease-out focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-sage"
          data-tina-field={tinaCtaLabelField}
        >
          <span>{ctaLabel}</span>
          {isExternal && <span aria-hidden="true">↗</span>}
        </a>
        {
          secondaryCtaHref && secondaryCtaLabel && (
            <a
              href={secondaryCtaHref}
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 font-body font-medium rounded-full bg-transparent border border-white/30 text-white px-7 py-3.5 text-base hover:bg-white/10 hover:border-white/60 transition-all duration-300 ease-out focus-visible:ring-2 focus-visible:ring-white"
            >
              <span>{secondaryCtaLabel}</span>
              <span aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </div>
  </Container>
</section>

