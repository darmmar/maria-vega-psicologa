---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
---

<section class="bg-primary-700 py-16 text-white">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-bold">¿Listo para dar el primer paso?</h2>
      <p class="mb-8 text-primary-100">
        Reserva una cita y empecemos a trabajar juntos en tu bienestar.
      </p>
      <Button href="/reserva" variant="secondary" size="lg">Reservar cita</Button>
    </div>
  </Container>
</section>
