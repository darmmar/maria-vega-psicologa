---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { Icon } from "astro-icon/components";
import { getSiteSettings } from "@/lib/content/collections";
import { imageSrc } from "@/lib/images";

const settings = await getSiteSettings();
const { hero } = settings;
const heroImage = imageSrc(hero.image);
const heroImageAlt = hero.imageAlt?.trim() || hero.imagePlaceholder;
---

<section class="relative overflow-hidden section-gap bg-warm-100">
  <div
    class="hidden md:block pointer-events-none absolute -right-32 top-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-sage-100/50 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="hidden md:block pointer-events-none absolute -left-24 bottom-0 w-[300px] h-[300px] rounded-full bg-warm-600/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <Container>
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="space-y-7">
        <span class="label-caps text-sage block">{hero.label}</span>

        <h1 class="font-display text-4xl md:text-5xl lg:text-[3.25rem] font-semibold text-ink leading-[1.1]">
          {hero.title}
        </h1>

        <p class="text-lg text-ink-muted leading-relaxed max-w-lg">
          {hero.description}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-1">
          <Button href={hero.primaryCta.href} size="lg">{hero.primaryCta.label}</Button>
          <Button href={hero.secondaryCta.href} variant="secondary" size="lg">
            {hero.secondaryCta.label}
          </Button>
        </div>

        <div class="flex flex-wrap gap-5 mt-2">
          {
            hero.badges.map((badge) => (
              <div class="flex items-center gap-2 text-ink-muted text-sm">
                <Icon name="lucide:check" class="w-4 h-4 text-sage flex-shrink-0" aria-hidden="true" />
                <span>{badge}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative hidden lg:flex justify-end">
        {
          heroImage ? (
            <figure class="w-full max-w-[360px]">
              <img
                src={heroImage}
                alt={heroImageAlt}
                class="w-full aspect-[4/5] object-cover shadow-[0_16px_48px_rgba(71,91,76,0.15)]"
                style="border-radius: 200px 200px 0 200px;"
                loading="eager"
                decoding="async"
              />
            </figure>
          ) : (
            <div
              class="w-full max-w-[360px] aspect-[4/5] overflow-hidden flex items-end justify-center bg-sage-100"
              style="border-radius: 200px 200px 0 200px;"
              aria-hidden="true"
            >
              <span class="label-caps text-sage-400 mb-10 pb-2">{hero.imagePlaceholder}</span>
            </div>
          )
        }
        <div
          class="absolute -bottom-6 -left-6 w-24 h-24 rounded-full bg-warm-600/30"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </Container>
</section>
