---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { Icon } from "astro-icon/components";
import { getSiteSettings } from "@/lib/content/collections";
import { imageSrc } from "@/lib/images";

const settings = await getSiteSettings();
const { hero } = settings;
const heroImage = imageSrc(hero.image);
const heroImageAlt = hero.imageAlt?.trim() || hero.imagePlaceholder;
---

<section class="relative overflow-hidden section-gap bg-gradient-to-b from-warm-100 to-warm-50/10">
  <!-- Soft background glowing blobs -->
  <div
    class="hidden md:block pointer-events-none absolute -right-32 top-1/4 w-[500px] h-[500px] rounded-full bg-sage-100/40 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="hidden md:block pointer-events-none absolute -left-24 bottom-10 w-[400px] h-[400px] rounded-full bg-blush-50/30 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <Container class="relative">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="space-y-7 lg:col-span-7 animate-fade-in-up">
        <span class="label-caps text-sage block tracking-wider">{hero.label}</span>

        <h1 class="font-display text-4xl md:text-5xl lg:text-[3.5rem] font-normal text-ink leading-[1.1] tracking-tight">
          {hero.title}
        </h1>

        <p class="text-lg text-ink-muted leading-relaxed max-w-xl font-body">
          {hero.description}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-1">
          <Button href={hero.primaryCta.href} size="lg">{hero.primaryCta.label}</Button>
          <Button href={hero.secondaryCta.href} variant="secondary" size="lg">
            {hero.secondaryCta.label}
          </Button>
        </div>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-2 pt-2 border-t border-ink-border/10">
          {
            hero.badges.map((badge, index) => (
              <>
                {index > 0 && <span class="text-ink-muted/30 select-none hidden sm:inline" aria-hidden="true">·</span>}
                <div class="flex items-center gap-2 text-ink-muted text-sm font-body">
                  <Icon name="lucide:check" class="w-4 h-4 text-sage flex-shrink-0" aria-hidden="true" />
                  <span>{badge}</span>
                </div>
              </>
            ))
          }
        </div>
      </div>

      <div class="relative hidden lg:flex justify-end lg:col-span-5 animate-fade-in">
        {
          heroImage ? (
            <figure class="w-full max-w-[360px] relative z-10">
              <img
                src={heroImage}
                alt={heroImageAlt}
                class="w-full aspect-[4/5] object-cover shadow-premium-hover transition-transform duration-700 hover:scale-[1.02]"
                style="border-radius: 160px 160px 0 160px;"
                loading="eager"
                decoding="async"
              />
            </figure>
          ) : (
            <div
              class="w-full max-w-[360px] aspect-[4/5] overflow-hidden flex items-end justify-center bg-sage-100/50 shadow-premium z-10"
              style="border-radius: 160px 160px 0 160px;"
              aria-hidden="true"
            >
              <span class="label-caps text-sage-400 mb-10 pb-2">{hero.imagePlaceholder}</span>
            </div>
          )
        }
        <!-- Decorative subtle shape in background -->
        <div
          class="absolute -bottom-6 -left-6 w-24 h-24 rounded-full bg-blush-100/60 blur-md -z-10"
          aria-hidden="true"
        >
        </div>
        <!-- Decorative ring offset behind image -->
        <div
          class="absolute right-4 -top-4 w-full max-w-[360px] aspect-[4/5] border border-sage/20 pointer-events-none -z-10"
          style="border-radius: 160px 160px 0 160px;"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </Container>
</section>

