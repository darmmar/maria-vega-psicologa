---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { Icon } from "astro-icon/components";
---

<section class="relative overflow-hidden section-gap bg-warm-100">
  <!-- Decorative organic blob -->
  <div
    class="hidden md:block pointer-events-none absolute -right-32 top-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-sage-100/50 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="hidden md:block pointer-events-none absolute -left-24 bottom-0 w-[300px] h-[300px] rounded-full bg-warm-600/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <Container>
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text content -->
      <div class="space-y-7">
        <span class="label-caps text-sage block">Psicóloga General Sanitaria · Málaga</span>

        <h1 class="font-display text-4xl md:text-5xl lg:text-[3.25rem] font-semibold text-ink leading-[1.1]">
          Un espacio para cuidarte
        </h1>

        <p class="text-lg text-ink-muted leading-relaxed max-w-lg">
          Terapia contextual y ACT en Málaga y online. Acompañamiento en duelo, ansiedad,
          adicciones y crecimiento personal desde un enfoque humano y basado en evidencia.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-1">
          <Button href="/reserva" size="lg">Reservar cita</Button>
          <Button href="/conoceme" variant="secondary" size="lg">Conóceme</Button>
        </div>

        <!-- Trust badges -->
        <div class="flex flex-wrap gap-5 mt-2">
          <div class="flex items-center gap-2 text-ink-muted text-sm">
            <Icon name="lucide:calendar" class="w-4 h-4 text-sage flex-shrink-0" aria-hidden="true" />
            <span>Cita en 24h</span>
          </div>
          <div class="flex items-center gap-2 text-ink-muted text-sm">
            <Icon name="lucide:lock" class="w-4 h-4 text-sage flex-shrink-0" aria-hidden="true" />
            <span>Confidencialidad total</span>
          </div>
          <div class="flex items-center gap-2 text-ink-muted text-sm">
            <Icon name="lucide:message-circle" class="w-4 h-4 text-sage flex-shrink-0" aria-hidden="true" />
            <span>Sin compromiso</span>
          </div>
        </div>
      </div>

      <!-- Image placeholder (editorial shape) -->
      <div class="relative hidden lg:flex justify-end">
        <div
          class="w-full max-w-[360px] aspect-[4/5] overflow-hidden flex items-end justify-center bg-sage-100"
          style="border-radius: 200px 200px 0 200px;"
        >
          <span class="label-caps text-sage-400 mb-10 pb-2">Foto profesional</span>
        </div>
        <!-- Small decorative circle -->
        <div
          class="absolute -bottom-6 -left-6 w-24 h-24 rounded-full bg-warm-600/30"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </Container>
</section>
