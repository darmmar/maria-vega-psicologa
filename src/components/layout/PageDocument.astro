---
import SeoHead from "@/components/seo/SeoHead.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import CookieBanner from "@/components/ui/CookieBanner.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import "@/styles/global.css";

import type { JsonLdDocument, JsonLdNode } from "@/lib/seo/types";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string | null;
  noindex?: boolean;
  jsonLd?: JsonLdNode | JsonLdNode[] | JsonLdDocument;
  ogType?: "website" | "article";
  publishedTime?: Date | string;
  island?: string;
  islandParams?: Record<string, string>;
}

const { title, description, canonical, ogImage, noindex, jsonLd, ogType, publishedTime, island, islandParams } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={jsonLd}
      ogType={ogType}
      publishedTime={publishedTime}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-warm-100 text-ink antialiased">
    <Header />
    {island ? (
      <TinaIsland name={island} params={islandParams} wrapper={{ tag: "main", className: "flex-1" }} primary>
        <slot />
      </TinaIsland>
    ) : <main class="flex-1"><slot /></main>}
    <Footer />
    <CookieBanner />
    <!-- Cloudflare Web Analytics (Privacy-first, 0-cookie, RGPD compliant) -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "1d02960f26d54b1d917b3bcfe9901b9f"}'></script>

  </body>
</html>
