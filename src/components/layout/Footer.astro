---
import { Icon } from 'astro-icon/components'
import Container from '../ui/Container.astro'
import { getSiteSettings } from '@/lib/content/collections'

const settings = await getSiteSettings()
const { contact } = settings

const socialLinks = [
  contact.instagram && {
    name: 'Instagram',
    icon: 'simple-icons:instagram',
    href: contact.instagram,
    label: 'Instagram de María Vega',
  },
  contact.whatsapp && {
    name: 'WhatsApp',
    icon: 'simple-icons:whatsapp',
    href: contact.whatsapp,
    label: 'WhatsApp de María Vega',
  },
  contact.telegram && {
    name: 'Telegram',
    icon: 'simple-icons:telegram',
    href: contact.telegram,
    label: 'Telegram de María Vega',
  },
  contact.tiktok && {
    name: 'TikTok',
    icon: 'simple-icons:tiktok',
    href: contact.tiktok,
    label: 'TikTok de María Vega',
  },
  contact.linkedin && {
    name: 'LinkedIn',
    icon: 'simple-icons:linkedin',
    href: contact.linkedin,
    label: 'LinkedIn de María Vega',
  },
].filter(Boolean) as Array<{
  name: string
  icon: string
  href: string
  label: string
}>

const legalLinks = [
  { label: 'Aviso legal', href: '/legal/aviso-legal' },
  { label: 'Privacidad', href: '/legal/privacidad' },
  { label: 'Cookies', href: '/legal/cookies' },
]
---

<footer class="border-t border-ink-border/30 bg-warm-100/40">
  <Container>
    <div class="py-10 lg:py-12 grid grid-cols-1 md:grid-cols-3 items-center gap-8 w-full">

      <div class="flex flex-col items-center md:items-start gap-1">
        <div class="flex items-center gap-2.5 text-sm text-ink-muted">
          <img
            src="/images/mv-monogram.png"
            alt=""
            width="1536"
            height="1024"
            class="h-9 w-[54px] flex-shrink-0"
            aria-hidden="true"
          />
          <div class="flex flex-col">
            <span class="font-medium">© {new Date().getFullYear()} María Vega Psicología</span>
            {settings.legal.collegiateNumber && (
              <span class="text-xs text-ink-faint">Nº Colegiada: {settings.legal.collegiateNumber}</span>
            )}
          </div>
        </div>
      </div>

      {
        socialLinks.length > 0 && (
          <div class="flex items-center justify-center gap-5">
            {socialLinks.map(({ icon, href, label }) => (
              <a
                href={href}
                aria-label={label}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink-faint hover:text-sage transition-colors p-2 hover:bg-sage/5 rounded-full"
              >
                <Icon name={icon} class="w-5 h-5" />
              </a>
            ))}
          </div>
        )
      }

      <nav aria-label="Pie de página legal" class="flex items-center justify-center md:justify-end gap-6 text-xs text-ink-faint">
        {legalLinks.map(({ label, href }) => (
          <a href={href} class="hover:text-ink transition-colors underline-offset-4 hover:underline">{label}</a>
        ))}
      </nav>

    </div>
  </Container>
</footer>
