---
import { Icon } from 'astro-icon/components'
import Container from '../ui/Container.astro'
import { siteConfig } from '@/lib/config/site'

const socialLinks = [
  siteConfig.contact.instagram && {
    name: 'Instagram',
    icon: 'simple-icons:instagram',
    href: siteConfig.contact.instagram,
    label: 'Instagram de María Vega',
  },
  siteConfig.contact.whatsapp && {
    name: 'WhatsApp',
    icon: 'simple-icons:whatsapp',
    href: siteConfig.contact.whatsapp,
    label: 'WhatsApp de María Vega',
  },
  siteConfig.contact.linkedin && {
    name: 'LinkedIn',
    icon: 'simple-icons:linkedin',
    href: siteConfig.contact.linkedin,
    label: 'LinkedIn de María Vega',
  },
].filter(Boolean) as Array<{
  name: string
  icon: string
  href: string
  label: string
}>

const legalLinks = [
  { label: 'Aviso legal', href: '/legal/aviso-legal' },
  { label: 'Privacidad', href: '/legal/privacidad' },
  { label: 'Cookies', href: '/legal/cookies' },
]
---

<footer class="border-t border-ink-border/30 bg-warm-100/40">
  <Container>
    <div class="py-10 lg:py-12 flex flex-col md:flex-row items-center justify-between gap-8">

      <div class="flex flex-col items-center md:items-start gap-1">
        <div class="flex items-center gap-2.5 text-sm text-ink-muted">
          <img
            src="/images/mv-monogram.png"
            alt=""
            width="56"
            height="62"
            class="h-9 w-auto flex-shrink-0"
            aria-hidden="true"
          />
          <span class="font-medium">© {new Date().getFullYear()} María Vega Psicología</span>
        </div>
        {
          siteConfig.legal.collegiateNumber && (
            <p class="text-xs text-ink-faint font-body md:pl-11 mt-1 text-center md:text-left">
              Psicóloga General Sanitaria · Nº Colegiada: {siteConfig.legal.collegiateNumber}
            </p>
          )
        }
      </div>

      {
        socialLinks.length > 0 && (
          <div class="flex items-center gap-5">
            {socialLinks.map(({ icon, href, label }) => (
              <a
                href={href}
                aria-label={label}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink-faint hover:text-sage transition-colors p-2 hover:bg-sage/5 rounded-full"
              >
                <Icon name={icon} class="w-5 h-5" />
              </a>
            ))}
          </div>
        )
      }

      <nav aria-label="Pie de página legal" class="flex items-center gap-6 text-xs text-ink-faint">
        {legalLinks.map(({ label, href }) => (
          <a href={href} class="hover:text-ink transition-colors underline-offset-4 hover:underline">{label}</a>
        ))}
      </nav>

    </div>
  </Container>
</footer>
