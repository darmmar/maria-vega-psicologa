---
import { Icon } from 'astro-icon/components'
import Container from '../ui/Container.astro'

const socialLinks = [
  { name: 'Instagram', icon: 'simple-icons:instagram', href: 'https://instagram.com/', label: 'Instagram de María Vega' },
  { name: 'TikTok', icon: 'simple-icons:tiktok', href: 'https://tiktok.com/', label: 'TikTok de María Vega' },
  { name: 'Telegram', icon: 'simple-icons:telegram', href: 'https://t.me/', label: 'Telegram de María Vega' },
  { name: 'WhatsApp', icon: 'simple-icons:whatsapp', href: 'https://wa.me/', label: 'WhatsApp de María Vega' },
]

const legalLinks = [
  { label: 'Aviso legal', href: '/legal/aviso-legal' },
  { label: 'Privacidad', href: '/legal/privacidad' },
  { label: 'Cookies', href: '/legal/cookies' },
]
---

<footer class="border-t border-ink-border bg-warm-100 mt-auto">
  <Container>
    <div class="py-6 flex flex-col sm:flex-row items-center justify-between gap-4">

      <!-- Brand -->
      <div class="text-sm text-ink-muted">
        <span class="font-display font-semibold text-ink">María Vega</span>
        <span class="mx-2 text-ink-border">·</span>
        <span>Psicóloga</span>
        <span class="mx-2 text-ink-border">·</span>
        <span>© {new Date().getFullYear()}</span>
      </div>

      <!-- Social icons -->
      <div class="flex items-center gap-4">
        {socialLinks.map(({ icon, href, label }) => (
          <a
            href={href}
            aria-label={label}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-faint hover:text-sage transition-colors"
          >
            <Icon name={icon} class="w-5 h-5" />
          </a>
        ))}
      </div>

      <!-- Legal links -->
      <nav aria-label="Pie de página legal" class="flex items-center gap-4 text-xs text-ink-faint">
        {legalLinks.map(({ label, href }) => (
          <a href={href} class="hover:text-ink transition-colors">{label}</a>
        ))}
      </nav>

    </div>
  </Container>
</footer>
