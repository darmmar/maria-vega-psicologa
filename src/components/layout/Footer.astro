---
import { siteConfig } from "@/lib/config/site";
import { legalNav } from "@/lib/config/navigation";
import Container from "@/components/ui/Container.astro";

const currentYear = new Date().getFullYear();
---

<footer class="bg-warm-200 border-t border-ink-border/40 py-14">
  <Container>
    <div class="flex flex-col md:flex-row justify-between gap-10">
      <!-- Brand -->
      <div class="max-w-sm">
        <span class="font-display text-xl font-semibold text-sage block mb-1">
          {siteConfig.professionalName}
        </span>
        <span class="font-body text-xs text-ink-faint block mb-4 uppercase tracking-wider">
          {siteConfig.professionalTitle}
        </span>
        <p class="text-sm text-ink-muted leading-relaxed">
          {siteConfig.description}
        </p>
      </div>

      <!-- Legal nav -->
      <div class="flex flex-col gap-3">
        <span class="label-caps text-ink-faint">Legal</span>
        <nav aria-label="Navegación legal" class="flex flex-col gap-2">
          {
            legalNav.map((item) => (
              <a
                href={item.href}
                class="text-sm text-ink-muted hover:text-sage-600 hover:underline underline-offset-2 transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-ink-border/40">
      <p class="text-xs text-ink-faint">
        &copy; {currentYear}
        {siteConfig.siteName}. Todos los derechos reservados.
      </p>
    </div>
  </Container>
</footer>
