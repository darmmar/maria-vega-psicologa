---
import SeoHead from "@/components/seo/SeoHead.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, canonical, ogImage, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen bg-warm-100 text-ink antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
