---
import SeoHead from "@/components/seo/SeoHead.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import CookieBanner from "@/components/ui/CookieBanner.astro";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

import type { JsonLdDocument, JsonLdNode } from "@/lib/seo/types";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: JsonLdNode | JsonLdNode[] | JsonLdDocument;
  ogType?: "website" | "article";
  publishedTime?: Date | string;
}

const { title, description, canonical, ogImage, noindex, jsonLd, ogType, publishedTime } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={jsonLd}
      ogType={ogType}
      publishedTime={publishedTime}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-warm-100 text-ink antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <!-- Cloudflare Web Analytics (Privacy-first, 0-cookie, RGPD compliant) -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "1d02960f26d54b1d917b3bcfe9901b9f"}'></script>

    <!-- TinaCMS visual editor in-iframe helper: navegación con doble-clic o Ctrl/Alt+clic y sincronización nativa con el editor visual -->
    <script is:inline>
      if (typeof window !== "undefined" && window.self !== window.top) {
        document.cookie = "__tina_edit=1; path=/; SameSite=Lax; max-age=86400";

        function navigateTina(targetHref) {
          try {
            const url = new URL(targetHref, window.location.origin);
            if (url.origin === window.location.origin && !url.pathname.startsWith("/admin")) {
              if (window.parent && window.parent !== window) {
                try {
                  const cleanPath = url.pathname.startsWith("/") ? url.pathname : "/" + url.pathname;
                  window.parent.location.hash = "#/~" + cleanPath;
                  return;
                } catch {}
              }
              url.searchParams.set("tina-edit", "1");
              window.location.href = url.pathname + url.search + url.hash;
            }
          } catch {
            window.location.href = targetHref;
          }
        }

        // Doble-clic en cualquier botón o enlace para navegar directamente dentro del editor visual
        document.addEventListener(
          "dblclick",
          (e) => {
            const anchor = e.target instanceof Element ? e.target.closest("a") : null;
            if (anchor && anchor.href) {
              e.preventDefault();
              e.stopPropagation();
              navigateTina(anchor.href);
            }
          },
          true
        );

        // Clic con Ctrl / Cmd / Alt presionado para navegar directamente en vez de seleccionar el campo para editar
        document.addEventListener(
          "click",
          (e) => {
            const anchor = e.target instanceof Element ? e.target.closest("a") : null;
            if (!anchor || !anchor.href) return;

            if (e.ctrlKey || e.metaKey || e.altKey) {
              e.preventDefault();
              e.stopPropagation();
              navigateTina(anchor.href);
              return;
            }

            try {
              const url = new URL(anchor.href, window.location.origin);
              if (url.origin === window.location.origin && !url.pathname.startsWith("/admin")) {
                if (!url.searchParams.has("tina-edit")) {
                  url.searchParams.set("tina-edit", "1");
                  anchor.href = url.pathname + url.search + url.hash;
                }
                anchor.setAttribute("data-astro-reload", "");
              }
            } catch {}
          },
          true
        );
      }
    </script>
  </body>
</html>
