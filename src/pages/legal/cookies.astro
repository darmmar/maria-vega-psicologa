---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
---

<Layout
  title="Política de Cookies"
  description="Política de cookies de María Vega Psicología."
  noindex={true}
>
  <section class="py-16">
    <Container>
      <div class="prose prose-gray max-w-none">
        <h1>Política de Cookies</h1>
        <p>
          Este sitio web puede utilizar cookies técnicas necesarias para su funcionamiento. No se
          utilizan cookies de rastreo ni publicidad sin tu consentimiento.
        </p>
        <p>Esta política se completará próximamente.</p>
      </div>
    </Container>
  </section>
</Layout>
