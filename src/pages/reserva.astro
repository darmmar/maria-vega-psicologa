---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import BookingPrivacyNotice from "@/components/sections/BookingPrivacyNotice.astro";
import CalEmbed from "@/components/islands/CalEmbed";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/lib/config/site";

const calUsername = siteConfig.booking.calComUsername ?? "maria-vega";
const { eventSlugs, availability } = siteConfig.booking;

const eventTypes = [
  {
    title: "Terapia presencial",
    description:
      "Sesión de psicología en consulta, en Málaga. Un espacio tranquilo y confidencial para tu proceso terapéutico.",
    duration: "60 min",
    format: availability.presencial,
    icon: "lucide:map-pin",
    slug: `${calUsername}/${eventSlugs.presencial}`,
    badge: null,
  },
  {
    title: "Terapia online",
    description:
      "Terapia por videollamada desde donde estés, con la misma calidad y privacidad que en consulta.",
    duration: "60 min",
    format: availability.online,
    icon: "lucide:monitor",
    slug: `${calUsername}/${eventSlugs.online}`,
    badge: "Recomendado si no estás en Málaga",
  },
];

const faqItems = [
  {
    question: "¿Cuáles son los horarios disponibles?",
    answer:
      "La terapia presencial en Málaga está disponible los lunes de 17:00 a 20:00. La terapia online se ofrece de martes a domingo, de 16:00 a 21:00 (hora peninsular). Los horarios exactos los verás al reservar según la disponibilidad del calendario.",
  },
  {
    question: "¿Qué ocurre después de reservar?",
    answer:
      "Recibirás un correo de confirmación con todos los detalles de la cita. Si es online, te llegará también el enlace a la videollamada. Puedes cancelar o reprogramar con al menos 24 horas de antelación.",
  },
  {
    question: "¿La primera consulta me compromete a seguir?",
    answer:
      "No. La primera sesión sirve para que nos conozcamos y veas si te sientes cómoda conmigo y con mi forma de trabajar. No hay ningún compromiso de continuidad.",
  },
  {
    question: "¿Cómo funciona la terapia online?",
    answer:
      "Las sesiones online se realizan por videollamada segura. Funcionan igual que las presenciales en cuanto a duración y estructura. Solo necesitas un lugar tranquilo y privado.",
  },
  {
    question: "¿Qué pasa si necesito cancelar?",
    answer:
      "Puedes cancelar o cambiar tu cita desde el enlace del correo de confirmación, con al menos 24 horas de antelación. Para cambios de último momento, escríbeme directamente.",
  },
];
---

<Layout
  title="Reserva"
  description="Reserva tu cita con María Vega, psicóloga en Málaga. Primera consulta y sesiones de seguimiento disponibles online y en consulta."
>
  <!-- Hero -->
  <section class="section-gap bg-warm-100 border-b border-ink-border/20">
    <Container>
      <div class="max-w-2xl">
        <span class="label-caps text-sage block mb-4">Reservas</span>
        <h1 class="font-display text-4xl lg:text-5xl font-semibold text-ink leading-tight mb-5">
          Reservar cita
        </h1>
        <p class="font-body text-lg text-ink-muted leading-relaxed">
          Dar el primer paso es lo más difícil. Aquí puedes elegir el momento que mejor te venga —
          sin llamadas, sin esperas.
        </p>
      </div>
    </Container>
  </section>

  <!-- Tipos de sesión -->
  <section class="section-gap">
    <Container>
      <span class="label-caps text-sage block mb-5">Tipos de sesión</span>
      <h2 class="font-display text-2xl lg:text-3xl font-semibold text-ink mb-10 leading-tight">
        ¿Qué tipo de cita necesitas?
      </h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          eventTypes.map((event) => (
            <Card class="flex flex-col gap-4">
              <div class="flex-1">
                <Icon name={event.icon} class="w-6 h-6 text-sage mb-4" />
                {event.badge && (
                  <span class="inline-block mb-3 rounded-full bg-sage/10 px-3 py-1 text-xs font-semibold text-sage">
                    {event.badge}
                  </span>
                )}
                <h3 class="font-display text-xl font-semibold text-ink mb-2">{event.title}</h3>
                <p class="font-body text-sm text-ink-muted leading-relaxed mb-4">
                  {event.description}
                </p>
                <div class="flex flex-wrap gap-3 text-xs text-ink-muted">
                  <span class="flex items-center gap-1.5">
                    <Icon name="lucide:clock" class="w-3.5 h-3.5" aria-hidden="true" />
                    {event.duration}
                  </span>
                  <span class="flex items-center gap-1.5">
                    <Icon name={event.icon} class="w-3.5 h-3.5" aria-hidden="true" />
                    {event.format}
                  </span>
                </div>
              </div>
              <Button
                href={`https://cal.com/${event.slug}`}
                variant="secondary"
                size="sm"
                external
              >
                Reservar esta sesión
              </Button>
            </Card>
          ))
        }
      </div>

      <p class="mt-8 text-center font-body text-sm text-ink-muted/70">
        Horarios en zona horaria de Madrid (CET/CEST). También puedes elegir día y hora directamente
        en el calendario de abajo o{" "}
        <a href="/contacto" class="underline underline-offset-2 hover:text-sage transition-colors">
          contactar por mensaje
        </a>{" "}
        si tienes dudas.
      </p>
    </Container>
  </section>

  <!-- Aviso de privacidad + Embed Cal.com -->
  <section class="section-gap bg-warm-200/40">
    <Container>
      <div class="max-w-4xl mx-auto">
        <span class="label-caps text-sage block mb-5">Calendario</span>
        <h2 class="font-display text-2xl lg:text-3xl font-semibold text-ink mb-6 leading-tight">
          Elige día y hora
        </h2>

        <div class="mb-6">
          <BookingPrivacyNotice />
        </div>

        <div class="rounded-2xl overflow-hidden border border-ink-border/30 bg-white shadow-sm">
          <CalEmbed calLink={calUsername} client:load />
        </div>
      </div>
    </Container>
  </section>

  <!-- FAQ reservas -->
  <section class="section-gap">
    <Container>
      <div class="max-w-3xl mx-auto">
        <span class="label-caps text-sage block mb-5">FAQ</span>
        <h2 class="font-display text-2xl lg:text-3xl font-semibold text-ink mb-10 leading-tight">
          Preguntas sobre las citas
        </h2>
        <div class="divide-y divide-ink-border/50">
          {
            faqItems.map((item) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-body font-semibold text-ink hover:text-sage transition-colors">
                  <span class="text-base">{item.question}</span>
                  <Icon
                    name="lucide:chevron-down"
                    class="w-5 h-5 flex-shrink-0 text-sage transition-transform duration-200 group-open:rotate-180"
                    aria-hidden="true"
                  />
                </summary>
                <p class="mt-3 font-body text-base text-ink-muted leading-relaxed">
                  {item.answer}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA alternativo -->
  <section class="section-gap bg-sage text-white">
    <Container>
      <div class="max-w-xl mx-auto text-center">
        <h2 class="font-display text-2xl lg:text-3xl font-semibold mb-4 leading-tight">
          ¿Prefieres contactar primero?
        </h2>
        <p class="font-body text-base text-white/80 mb-8 leading-relaxed">
          Si tienes dudas antes de reservar, escríbeme. Estaré encantada de resolverlas.
        </p>
        <Button href="/contacto" variant="secondary" size="lg" class="border-white text-white hover:bg-white/10 hover:border-white">
          Ir a contacto
        </Button>
      </div>
    </Container>
  </section>
</Layout>
