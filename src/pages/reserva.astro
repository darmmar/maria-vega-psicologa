---
export const prerender = false;
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Card from "@/components/ui/Card.astro";
import PageHero from "@/components/ui/PageHero.astro";
import BookingPrivacyNotice from "@/components/sections/BookingPrivacyNotice.astro";
import CalEmbed from "@/components/islands/CalEmbed";
import FAQAccordion from "@/components/islands/FAQAccordion";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/lib/config/site";
import { getBookingPage } from "@/lib/content/collections";
import { buildBreadcrumbList, buildFAQPage, buildJsonLdGraph, buildPerson } from "@/lib/seo";
import { tinaField } from "@tinacms/astro";

let page = await getBookingPage();

try {
  const { requestWithMetadata } = await import("@tinacms/astro");
  const client = (await import("../../tina/__generated__/client")).default;
  const tinaRes = await requestWithMetadata(
    client.queries.bookingPage({ relativePath: "booking.json" }),
    { priority: "primary" }
  );
  if (tinaRes?.data?.bookingPage) {
    page = tinaRes.data.bookingPage as any;
  }
} catch (e) {
  // Mantener fallback
}

const { hero, sessions, faqItems } = page;
const calComUsername = page.calComUsername || siteConfig.booking.calComUsername;

const tinaFaqItems = (faqItems ?? []).map((item: any, index: number) => ({
  question: item.question,
  answer: item.answer,
  tinaFieldItem: tinaField(page, "faqItems", index),
  tinaFieldQuestion: tinaField(item, "question"),
  tinaFieldAnswer: tinaField(item, "answer"),
}));

const pageUrl = "/reserva";
const jsonLd = buildJsonLdGraph(
  buildPerson(),
  buildFAQPage(faqItems),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: "Reserva", url: pageUrl },
  ])
);
---

<Layout
  title={page.seoTitle ?? hero.title}
  description={page.seoDescription ?? hero.intro}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <PageHero
    label={hero.label}
    title={hero.title}
    description={hero.intro}
    align="center"
    tinaLabelField={tinaField(page.hero, "label")}
    tinaTitleField={tinaField(page.hero, "title")}
    tinaDescriptionField={tinaField(page.hero, "intro")}
  />

  <!-- Tipos de sesión -->
  <section class="section-gap-tight bg-gradient-to-b from-warm-50/20 to-warm-100/10">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-10 animate-fade-in">
        <span class="label-caps text-sage block mb-3" data-tina-field={tinaField(page.sessionsSection, "label")}>
          {page.sessionsSection?.label ?? "Tipos de sesión"}
        </span>
        <h2 class="font-display text-2xl lg:text-3xl font-normal text-ink leading-tight" data-tina-field={tinaField(page.sessionsSection, "title")}>
          {page.sessionsSection?.title ?? "¿Qué tipo de cita necesitas?"}
        </h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 max-w-4xl mx-auto animate-fade-in-up">
        {
          sessions.map((event: any, index: number) => {
            const isPresencial = event.title.toLowerCase().includes("presencial");
            const tipo = isPresencial ? "presencial" : "online";
            const infoHref = isPresencial ? "/terapia-presencial" : "/terapia-online";
            const infoText = isPresencial
              ? "Conoce los detalles de la consulta presencial →"
              : "Conoce los detalles de la terapia online →";

            return (
              <Card
                class="flex flex-col gap-4 p-6 sm:p-8 hover:-translate-y-1 transition-all duration-300"
                data-tina-field={tinaField(page, "sessions", index)}
              >
                <div class="flex-1">
                  <div class="w-10 h-10 rounded-xl bg-sage/5 flex items-center justify-center text-sage mb-5" aria-hidden="true">
                    <Icon name={event.icon} class="w-5 h-5" />
                  </div>
                  {event.badge && (
                    <span
                      class="inline-block mb-4 rounded-full bg-blush/10 border border-blush/20 px-3 py-1 text-[10px] font-semibold text-blush-700 label-caps tracking-wide"
                      data-tina-field={tinaField(event, "badge")}
                    >
                      {event.badge}
                    </span>
                  )}
                  <h3 class="font-display text-xl font-normal text-ink mb-3" data-tina-field={tinaField(event, "title")}>{event.title}</h3>
                  <p class="font-body text-sm text-ink-muted leading-relaxed mb-5" data-tina-field={tinaField(event, "description")}>
                    {event.description}
                  </p>
                  <div class="flex flex-wrap gap-4 text-xs text-ink-muted border-t border-ink-border/10 pt-4 font-body">
                    <span class="flex items-center gap-1.5" data-tina-field={tinaField(event, "duration")}>
                      <Icon name="lucide:clock" class="w-4 h-4 text-sage" aria-hidden="true" />
                      {event.duration}
                    </span>
                    <span class="flex items-center gap-1.5" data-tina-field={tinaField(event, "format")}>
                      <Icon name={event.icon} class="w-4 h-4 text-sage" aria-hidden="true" />
                      {event.format}
                    </span>
                  </div>
                </div>
                <div class="pt-2">
                  <a
                    href="#calendario"
                    data-select-cal-type={tipo}
                    class="w-full text-center justify-center inline-flex items-center gap-1.5 text-sm font-medium py-3 px-4 rounded-xl bg-sage text-white hover:bg-sage-600 shadow-sm transition-all duration-200"
                  >
                    Ver citas disponibles en calendario ↓
                  </a>
                  <a
                    href={infoHref}
                    class="text-xs text-sage font-medium hover:underline text-center block pt-3 font-body"
                  >
                    {infoText}
                  </a>
                </div>
              </Card>
            );
          })
        }
      </div>
    </Container>
  </section>

  <!-- Aviso de privacidad + Embed Cal.com -->
  {
    calComUsername && (
      <section id="calendario" class="section-gap-tight bg-gradient-to-b from-warm-100/50 to-warm-200/30 border-y border-ink-border/10 scroll-mt-24">
        <Container>
          <div class="max-w-4xl mx-auto">
            <div class="text-center mb-8">
              <span class="label-caps text-sage block mb-2" data-tina-field={tinaField(page.calendarSection, "label")}>
                {page.calendarSection?.label ?? "Calendario en vivo"}
              </span>
              <h2 class="font-display text-2xl lg:text-3xl font-normal text-ink leading-tight" data-tina-field={tinaField(page.calendarSection, "title")}>
                {page.calendarSection?.title ?? "Elige tu cita online o presencial"}
              </h2>
            </div>

            <div class="mb-6">
              <BookingPrivacyNotice />
            </div>

            <div class="rounded-3xl overflow-hidden border border-ink-border/20 bg-white shadow-premium p-4 sm:p-6">
              <CalEmbed client:load calLink={calComUsername} defaultUsername={calComUsername} />
            </div>
          </div>
        </Container>
      </section>
    )
  }

  <script>
    document.querySelectorAll("[data-select-cal-type]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const type = btn.getAttribute("data-select-cal-type");
        if (type) {
          window.dispatchEvent(new CustomEvent("cal-select-type", { detail: type }));
        }
      });
    });
  </script>

  <!-- FAQ reservas -->
  <section class="section-gap-tight bg-gradient-to-b from-warm-50/10 to-warm-100/20">
    <Container>
      <div class="max-w-3xl mx-auto animate-fade-in-up">
        <span class="label-caps text-sage block mb-4" data-tina-field={tinaField(page.faqSection, "label")}>
          {page.faqSection?.label ?? "FAQ"}
        </span>
        <h2 class="font-display text-2xl lg:text-3xl font-normal text-ink mb-10 leading-tight" data-tina-field={tinaField(page.faqSection, "title")}>
          {page.faqSection?.title ?? "Preguntas sobre las citas"}
        </h2>
        <FAQAccordion items={tinaFaqItems} client:visible />
      </div>
    </Container>
  </section>

  <!-- CTA alternativo -->
  <section class="section-gap bg-gradient-to-br from-sage to-sage-700 relative overflow-hidden text-white">
    <div class="absolute -top-32 -left-32 w-80 h-80 bg-white/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <Container class="relative">
      <div class="max-w-2xl mx-auto text-center space-y-6">
        <h2 class="font-display text-3xl lg:text-4xl font-normal mb-4 leading-tight" data-tina-field={tinaField(page.cta, "title")}>
          {page.cta?.title ?? "¿Prefieres contactar primero?"}
        </h2>
        <p class="font-body text-base text-white/80 mb-8 leading-relaxed" data-tina-field={tinaField(page.cta, "description")}>
          {page.cta?.description ?? "Si tienes dudas antes de reservar, escríbeme. Estaré encantada de resolverlas."}
        </p>
        <a
          href={page.cta?.href ?? "/contacto"}
          class="inline-flex items-center gap-2 font-body font-medium rounded-lg bg-white text-sage px-8 py-4 text-base hover:bg-warm-50 hover:shadow-premium hover:-translate-y-0.5 active:translate-y-0 active:shadow-none transition-all duration-300 ease-out focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-sage"
          data-tina-field={tinaField(page.cta, "label")}
        >
          {page.cta?.label ?? "Ir a contacto"}
        </a>
      </div>
    </Container>
  </section>
</Layout>
