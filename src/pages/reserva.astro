---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
---

<Layout
  title="Reservar Cita"
  description="Reserva tu cita con María Vega, psicóloga en Málaga. Terapia presencial y online disponible. Elige el horario que mejor te convenga."
>
  <section class="py-16">
    <Container>
      <h1 class="mb-6 text-4xl font-bold text-gray-900">Reservar cita</h1>
      <p class="text-lg text-gray-600">
        El sistema de reservas se integrará próximamente. Por favor, contáctame para concertar tu
        primera cita.
      </p>
    </Container>
  </section>
</Layout>
