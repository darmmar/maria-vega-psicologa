---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import PageHero from "@/components/ui/PageHero.astro";
import BookingPrivacyNotice from "@/components/sections/BookingPrivacyNotice.astro";
import CalEmbed from "@/components/islands/CalEmbed";
import FAQAccordion from "@/components/islands/FAQAccordion";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/lib/config/site";
import { getBookingPage } from "@/lib/content/collections";
import { buildBreadcrumbList, buildFAQPage, buildJsonLdGraph, buildPerson } from "@/lib/seo";

const page = await getBookingPage();
const { hero, sessions, faqItems } = page;
const calComUsername = page.calComUsername || siteConfig.booking.calComUsername;

const pageUrl = "/reserva";
const jsonLd = buildJsonLdGraph(
  buildPerson(),
  buildFAQPage(faqItems),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: "Reserva", url: pageUrl },
  ])
);
---

<Layout
  title={page.seoTitle}
  description={page.seoDescription}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <PageHero
    label={hero.label}
    title={hero.title}
    description={hero.intro}
    align="left"
  />

  <!-- Tipos de sesión -->
  <section class="section-gap-tight bg-gradient-to-b from-warm-50/20 to-warm-100/10">
    <Container>
      <span class="label-caps text-sage block mb-4">Tipos de sesión</span>
      <h2 class="font-display text-2xl lg:text-3xl font-normal text-ink mb-10 leading-tight">
        ¿Qué tipo de cita necesitas?
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 max-w-4xl animate-fade-in-up">
        {
          sessions.map((event) => (
            <Card class="flex flex-col gap-4 p-6 sm:p-8 hover:-translate-y-1 transition-all duration-300">
              <div class="flex-1">
                <div class="w-10 h-10 rounded-xl bg-sage/5 flex items-center justify-center text-sage mb-5" aria-hidden="true">
                  <Icon name={event.icon} class="w-5 h-5" />
                </div>
                {event.badge && (
                  <span class="inline-block mb-4 rounded-full bg-blush/10 border border-blush/20 px-3 py-1 text-[10px] font-semibold text-blush-700 label-caps tracking-wide">
                    {event.badge}
                  </span>
                )}
                <h3 class="font-display text-xl font-normal text-ink mb-3">{event.title}</h3>
                <p class="font-body text-sm text-ink-muted leading-relaxed mb-5">
                  {event.description}
                </p>
                <div class="flex flex-wrap gap-4 text-xs text-ink-muted border-t border-ink-border/10 pt-4 font-body">
                  <span class="flex items-center gap-1.5">
                    <Icon name="lucide:clock" class="w-4 h-4 text-sage" aria-hidden="true" />
                    {event.duration}
                  </span>
                  <span class="flex items-center gap-1.5">
                    <Icon name={event.icon} class="w-4 h-4 text-sage" aria-hidden="true" />
                    {event.format}
                  </span>
                </div>
              </div>
              <Button
                href={event.bookingUrl}
                variant="secondary"
                size="sm"
                external
              >
                Reservar esta sesión
              </Button>
            </Card>
          ))
        }
      </div>

      <p class="mt-8 text-center font-body text-sm text-ink-muted/70 max-w-2xl mx-auto">
        Si tienes alguna duda sobre las sesiones o prefieres consultar antes de reservar, puedes 
        <a href="/contacto" class="underline underline-offset-4 text-sage font-medium hover:text-sage-600 transition-colors">
          escribirme un mensaje
        </a>.
      </p>
    </Container>
  </section>

  <!-- Aviso de privacidad + Embed Cal.com -->
  {
    calComUsername && (
      <section class="section-gap-tight bg-gradient-to-b from-warm-100/50 to-warm-200/30 border-y border-ink-border/10">
        <Container>
          <div class="max-w-4xl mx-auto">
            <span class="label-caps text-sage block mb-4">Calendario</span>
            <h2 class="font-display text-2xl lg:text-3xl font-normal text-ink mb-6 leading-tight">
              Elige día y hora
            </h2>

            <div class="mb-6">
              <BookingPrivacyNotice />
            </div>

            <div class="rounded-3xl overflow-hidden border border-ink-border/20 bg-white shadow-premium p-1">
              <CalEmbed calLink={calComUsername} client:visible />
            </div>
          </div>
        </Container>
      </section>
    )
  }

  <!-- FAQ reservas -->
  <section class="section-gap-tight bg-gradient-to-b from-warm-50/10 to-warm-100/20">
    <Container>
      <div class="max-w-3xl mx-auto animate-fade-in-up">
        <span class="label-caps text-sage block mb-4">FAQ</span>
        <h2 class="font-display text-2xl lg:text-3xl font-normal text-ink mb-10 leading-tight">
          Preguntas sobre las citas
        </h2>
        <FAQAccordion items={faqItems} client:visible />
      </div>
    </Container>
  </section>

  <!-- CTA alternativo -->
  <section class="section-gap bg-gradient-to-br from-sage to-sage-700 relative overflow-hidden text-white">
    <div class="absolute -top-32 -left-32 w-80 h-80 bg-white/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <Container class="relative">
      <div class="max-w-2xl mx-auto text-center space-y-6">
        <h2 class="font-display text-3xl lg:text-4xl font-normal mb-4 leading-tight">
          ¿Prefieres contactar primero?
        </h2>
        <p class="font-body text-base text-white/80 mb-8 leading-relaxed">
          Si tienes dudas antes de reservar, escríbeme. Estaré encantada de resolverlas.
        </p>
        <a
          href="/contacto"
          class="inline-flex items-center gap-2 font-body font-medium rounded-lg bg-white text-sage px-8 py-4 text-base hover:bg-warm-50 hover:shadow-premium hover:-translate-y-0.5 active:translate-y-0 active:shadow-none transition-all duration-300 ease-out focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-sage"
        >
          Ir a contacto
        </a>
      </div>
    </Container>
  </section>
</Layout>
