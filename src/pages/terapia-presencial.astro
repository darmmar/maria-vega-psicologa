---
export const prerender = false;
import Layout from "@/components/layout/Layout.astro";
import CTASection from "@/components/sections/CTASection.astro";
import ServicePage from "@/components/pages/ServicePage.astro";
import { getServiceBySlug } from "@/lib/content/collections";
import { buildServicePageJsonLd } from "@/lib/seo";

import { tinaField } from "@tinacms/astro";

let service = await getServiceBySlug("terapia-presencial");
if (!service) return Astro.redirect("/404");

try {
  const { requestWithMetadata } = await import("@tinacms/astro");
  const client = (await import("../../tina/__generated__/client")).default;
  const tinaServiceRes = await requestWithMetadata(
    client.queries.services({ relativePath: "terapia-presencial.mdx" }),
    { priority: "primary" }
  );
  if (tinaServiceRes?.data?.services) {
    service.data = { ...service.data, ...(tinaServiceRes.data.services as any) };
  }
} catch (e) {}

const pageUrl = "/terapia-presencial";
const jsonLd = buildServicePageJsonLd({
  title: service.data.title,
  description: service.data.description,
  path: pageUrl,
});
---

<Layout
  title={service.data.seoTitle ?? service.data.title}
  description={service.data.seoDescription ?? service.data.description}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <ServicePage slug="terapia-presencial" heroLayout="centered" standalone={false} />
  <CTASection
    title={service.data.ctaTitle || "¿Quieres empezar tu proceso?"}
    description={service.data.ctaDescription || "Elige el día y la hora que mejor se adapten a tu horario para tu sesión presencial en consulta (Málaga)."}
    ctaLabel={service.data.ctaLabel || "Reservar cita presencial"}
    ctaHref={service.data.ctaHref || "https://cal.com/maria-vega/terapia-presencial"}
    secondaryCtaLabel="Escribir un mensaje"
    secondaryCtaHref="/contacto"
    tinaTitleField={tinaField(service.data, "ctaTitle")}
    tinaDescriptionField={tinaField(service.data, "ctaDescription")}
    tinaCtaLabelField={tinaField(service.data, "ctaLabel")}
  />
</Layout>
