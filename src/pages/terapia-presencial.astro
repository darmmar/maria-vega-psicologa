---
export const prerender = false;
import Layout from "@/components/layout/Layout.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import CTASection from "@/components/sections/CTASection.astro";
import ServicePage from "@/components/pages/ServicePage.astro";
import { getServiceBySlug, getServicesForGrid, getSiteSettings } from "@/lib/content/collections";
import { buildServicePageJsonLd } from "@/lib/seo";

import { tinaField } from "@tinacms/astro";

let [settings, services, service] = await Promise.all([
  getSiteSettings(),
  getServicesForGrid(),
  getServiceBySlug("terapia-presencial"),
]);

try {
  const { requestWithMetadata } = await import("@tinacms/astro");
  const client = (await import("../../tina/__generated__/client")).default;
  const tinaSettingsRes = await requestWithMetadata(
    client.queries.siteSettings({ relativePath: "settings.json" })
  );
  if (tinaSettingsRes?.data?.siteSettings) {
    settings = { ...settings, ...(tinaSettingsRes.data.siteSettings as any) };
  }
} catch (e) {}

if (!service) return Astro.redirect("/404");

const pageUrl = "/terapia-presencial";
const jsonLd = buildServicePageJsonLd({
  title: service.data.title,
  description: service.data.description,
  path: pageUrl,
});
---

<Layout
  title={service.data.seoTitle ?? service.data.title}
  description={service.data.seoDescription ?? service.data.description}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <ServicePage slug="terapia-presencial" heroLayout="centered" standalone={false} />
  <ServicesGrid
    services={services.filter((s) => s.href !== "/terapia-presencial")}
    sectionLabel={settings.servicesSection.label}
    sectionTitle={settings.servicesSection.title}
    tinaSectionLabelField={tinaField(settings.servicesSection, "label")}
    tinaSectionTitleField={tinaField(settings.servicesSection, "title")}
  />
  <CTASection
    title={settings.cta.title}
    description={settings.cta.description}
    ctaLabel={settings.cta.label}
    ctaHref={settings.cta.href}
    tinaTitleField={tinaField(settings.cta, "title")}
    tinaDescriptionField={tinaField(settings.cta, "description")}
    tinaCtaLabelField={tinaField(settings.cta, "label")}
  />
</Layout>
