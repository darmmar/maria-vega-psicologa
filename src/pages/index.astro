---
export const prerender = false;
import Layout from "@/components/layout/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import TherapyApproach from "@/components/sections/TherapyApproach.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import ExperienceBlock from "@/components/sections/ExperienceBlock.astro";
import TrainingBlock from "@/components/sections/TrainingBlock.astro";
import CourseHighlight from "@/components/sections/CourseHighlight.astro";
import CTASection from "@/components/sections/CTASection.astro";
import HomeFaq from "@/components/sections/HomeFaq.astro";
import SectionDivider from "@/components/ui/SectionDivider.astro";
import { buildFAQPage, buildJsonLdGraph, buildMedicalBusiness, buildPerson, buildWebSite } from "@/lib/seo";
import { getCourseBySlug, getFaq, getPublishedExperience, getPublishedTraining, getServicesForGrid, getSiteSettings } from "@/lib/content/collections";
import { tinaField } from "@tinacms/astro";

let [settings, course, services, rawFaqs, rawExp, rawTraining] = await Promise.all([
  getSiteSettings(),
  getCourseBySlug("curso-duelo"),
  getServicesForGrid(),
  getFaq(),
  getPublishedExperience(),
  getPublishedTraining(),
]);

try {
  const { requestWithMetadata } = await import("@tinacms/astro");
  const client = (await import("../../tina/__generated__/client")).default;
  const tinaRes = await requestWithMetadata(
    client.queries.siteSettings({ relativePath: "settings.json" }),
    { priority: "primary" }
  );
  if (tinaRes?.data?.siteSettings) {
    settings = tinaRes.data.siteSettings as any;
  }
} catch {}

const rawFaqList = settings.faqSection?.items ?? rawFaqs.map((f) => ({
  question: f.data.question,
  answer: f.data.answer,
}));

const finalFaqItems = rawFaqList.map((f: any, index: number) => ({
  question: f.question ?? f.data?.question,
  answer: f.answer ?? f.data?.answer,
  tinaFieldItem: settings.faqSection?.items ? tinaField(settings.faqSection, "items", index) : undefined,
  tinaFieldQuestion: settings.faqSection?.items ? tinaField(f, "question") : undefined,
  tinaFieldAnswer: settings.faqSection?.items ? tinaField(f, "answer") : undefined,
}));

const businessOverrides = {
  address: settings.legal.address,
  phone: settings.contact.phone,
  email: settings.contact.email,
  googleMapsLink: settings.contact.googleMapsLink,
  collegiateNumber: settings.legal.collegiateNumber,
  businessName: settings.legal.businessName,
  instagram: settings.contact.instagram,
  linkedin: settings.contact.linkedin,
};

const jsonLd = buildJsonLdGraph(
  buildWebSite(),
  buildMedicalBusiness(businessOverrides),
  buildPerson({ overrides: businessOverrides }),
  buildFAQPage(finalFaqItems)
);

const modalityHrefs = ["/terapia-presencial", "/terapia-online"];
const rawServicesList = settings.servicesSection?.items ?? services.filter((s) => !modalityHrefs.includes(s.href));
const clinicalServices = rawServicesList.map((s: any, index: number) => {
  const isSettingsItem = Boolean(settings.servicesSection?.items);
  return {
    ...s,
    tinaFieldCard: isSettingsItem ? tinaField(settings.servicesSection, "items", index) : undefined,
    tinaFieldTitle: isSettingsItem ? tinaField(s, "title") : undefined,
    tinaFieldDescription: isSettingsItem ? tinaField(s, "shortDescription") : undefined,
    tinaFieldThumbnail: isSettingsItem ? tinaField(s, "thumbnail") : undefined,
  };
});

const experienceItems = rawExp;
const trainingItems = rawTraining;

const pageTitle = settings.seo?.homeTitle ?? settings.hero.title;
const pageDescription = settings.seo?.homeDescription ?? settings.hero.description;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/"
  jsonLd={jsonLd}
>
  <Hero siteSettings={settings} />
  <TherapyApproach therapyApproach={settings.therapyApproach} />
  <ServicesGrid
    services={clinicalServices}
    sectionLabel={settings.servicesSection.label}
    sectionTitle={settings.servicesSection.title}
    tinaSectionLabel={tinaField(settings.servicesSection, "label")}
    tinaSectionTitle={tinaField(settings.servicesSection, "title")}
  />
  <SectionDivider />
  <ExperienceBlock
    experienceSection={settings.experienceSection}
    items={experienceItems}
    tinaLabelField={tinaField(settings.experienceSection, "label")}
    tinaTitleField={tinaField(settings.experienceSection, "title")}
  />
  <TrainingBlock
    trainingSection={settings.trainingSection}
    items={trainingItems}
    tinaLabelField={tinaField(settings.trainingSection, "label")}
    tinaTitleField={tinaField(settings.trainingSection, "title")}
    tinaClinicalTitleField={tinaField(settings.trainingSection, "clinicalTitle")}
    tinaComplementaryTitleField={tinaField(settings.trainingSection, "complementaryTitle")}
  />
  <SectionDivider />
  <CourseHighlight
    title={course?.data.title}
    description={course?.data.shortDescription}
    label={settings.courseHighlight.label}
    ctaLabel={settings.courseHighlight.ctaLabel}
    ctaHref={settings.courseHighlight.ctaHref}
    tinaLabelField={tinaField(settings.courseHighlight, "label")}
    tinaCtaLabelField={tinaField(settings.courseHighlight, "ctaLabel")}
  />
  <HomeFaq
    items={finalFaqItems}
    label={settings.faqSection?.label ?? "Preguntas frecuentes"}
    title={settings.faqSection?.title ?? "Respuestas sobre el proceso de terapia"}
    description={settings.faqSection?.description ?? "Resolver tus dudas antes de comenzar es fundamental para dar el paso con tranquilidad y confianza."}
    tinaLabelField={tinaField(settings.faqSection, "label")}
    tinaTitleField={tinaField(settings.faqSection, "title")}
    tinaDescriptionField={tinaField(settings.faqSection, "description")}
  />
  <CTASection
    title={settings.cta.title}
    description={settings.cta.description}
    ctaLabel={settings.cta.label}
    ctaHref={settings.cta.href}
    tinaTitleField={tinaField(settings.cta, "title")}
    tinaDescriptionField={tinaField(settings.cta, "description")}
    tinaCtaLabelField={tinaField(settings.cta, "label")}
  />
</Layout>
