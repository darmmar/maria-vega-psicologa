---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import CourseHighlight from "@/components/sections/CourseHighlight.astro";
---

<Layout
  title="Curso de Duelo"
  description="Curso online para afrontar el duelo con herramientas psicológicas basadas en evidencia. Aprende a navegar el proceso de pérdida."
>
  <section class="py-16">
    <Container>
      <h1 class="mb-6 text-4xl font-bold text-gray-900">Curso: Afrontando el duelo</h1>
      <p class="text-lg text-gray-600">Contenido en construcción.</p>
    </Container>
  </section>
  <CourseHighlight />
</Layout>
