---
import Layout from '@/components/layout/Layout.astro'
import Container from '@/components/ui/Container.astro'
import Button from '@/components/ui/Button.astro'
import CTASection from '@/components/sections/CTASection.astro'
import { render } from 'astro:content'
import { getServiceBySlug } from '@/lib/content/collections'

const service = await getServiceBySlug('terapia-infantil-juvenil')
if (!service) return Astro.redirect('/404')
const { Content } = await render(service)
---

<Layout
  title={`${service.data.title} — María Vega Psicología`}
  description={service.data.seoDescription ?? service.data.description}
>
  <section class="section-gap bg-warm-100">
    <Container>
      <div class="max-w-3xl mx-auto">
        <p class="label-caps text-sage mb-3">Psicología</p>
        <h1 class="font-display text-4xl lg:text-5xl font-semibold text-ink mb-6 leading-tight">
          {service.data.title}
        </h1>
        <p class="text-ink-muted text-xl leading-relaxed mb-8">{service.data.description}</p>
        <Button href="/reserva" variant="primary" size="lg">Reservar cita</Button>
      </div>
    </Container>
  </section>

  <section class="section-gap">
    <Container>
      <div class="max-w-2xl mx-auto prose prose-lg prose-slate">
        <Content />
      </div>
    </Container>
  </section>

  <CTASection />
</Layout>
