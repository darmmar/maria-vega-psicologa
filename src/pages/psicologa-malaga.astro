---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import CTASection from "@/components/sections/CTASection.astro";
---

<Layout
  title="Psicóloga en Málaga"
  description="Psicóloga general sanitaria en Málaga. Terapia individual presencial basada en evidencia científica. Primeras citas disponibles."
>
  <section class="py-16">
    <Container>
      <h1 class="mb-6 text-4xl font-bold text-gray-900">Psicóloga en Málaga</h1>
      <p class="text-lg text-gray-600">Contenido en construcción.</p>
    </Container>
  </section>
  <ServicesGrid />
  <CTASection />
</Layout>
