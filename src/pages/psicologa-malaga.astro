---
import Layout from '@/components/layout/Layout.astro'
import Container from '@/components/ui/Container.astro'
import ServicesGrid from '@/components/sections/ServicesGrid.astro'
import CTASection from '@/components/sections/CTASection.astro'
import ProseWrapper from '@/components/ui/ProseWrapper.astro'
import { Icon } from 'astro-icon/components'
import { render } from 'astro:content'
import { getServiceBySlug } from '@/lib/content/collections'

const service = await getServiceBySlug('psicologa-malaga')
if (!service) return Astro.redirect('/404')
const { Content } = await render(service)

const services = [
  {
    title: 'Terapia de duelo',
    shortDescription: 'Acompañamiento en la pérdida y el proceso de duelo.',
    href: '/terapia-duelo',
  },
  {
    title: 'Ansiedad y estrés',
    shortDescription: 'Herramientas para gestionar el malestar emocional.',
    href: '/terapia-ansiedad',
  },
  {
    title: 'Adicciones',
    shortDescription: 'Apoyo en conductas adictivas y dependencias.',
    href: '/terapia-adicciones',
  },
  {
    title: 'Infantil y juvenil',
    shortDescription: 'Atención a niños y adolescentes.',
    href: '/terapia-infantil-juvenil',
  },
  {
    title: 'Terapia online',
    shortDescription: 'Sesiones a distancia con la misma calidad.',
    href: '/terapia-online',
  },
  {
    title: 'Terapia contextual ACT',
    shortDescription: 'Aceptación, valores y acción comprometida.',
    href: '/terapia-contextual-act',
  },
]
---

<Layout
  title={`${service.data.title} — María Vega Psicología`}
  description={service.data.seoDescription ?? service.data.description}
>
  <section class="py-12 lg:py-16 bg-warm-100">
    <Container>
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <p class="label-caps text-sage mb-3">Psicología</p>
          <h1 class="font-display text-4xl lg:text-5xl font-semibold text-ink mb-4 leading-tight">
            {service.data.title}
          </h1>
          <p class="text-ink-muted text-xl leading-relaxed">{service.data.description}</p>
        </div>
        <div class="hidden md:flex justify-end" aria-hidden="true">
          <Icon name="lucide:map-pin" class="w-40 h-40 text-sage opacity-15" />
        </div>
      </div>
    </Container>
  </section>

  <section class="py-12 lg:py-20">
    <Container>
      <ProseWrapper>
        <Content />
      </ProseWrapper>
    </Container>
  </section>

  <ServicesGrid services={services} />

  <CTASection />
</Layout>
