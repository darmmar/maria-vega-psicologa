---
import Layout from '../../components/layout/Layout.astro'
import Container from '../../components/ui/Container.astro'
import Badge from '../../components/ui/Badge.astro'
import Button from '../../components/ui/Button.astro'
import { render } from 'astro:content'
import { getPublishedResources } from '../../lib/content/collections'

export async function getStaticPaths() {
  const resources = await getPublishedResources()
  return resources.map((r) => ({
    params: { slug: r.data.slug },
    props: { resource: r },
  }))
}

const { resource } = Astro.props
const { Content } = await render(resource)
---
<Layout
  title={resource.data.seoTitle ?? resource.data.title}
  description={resource.data.seoDescription ?? resource.data.description}
>
  <Container>
    <article class="max-w-2xl mx-auto py-8 lg:py-12">
      {resource.data.tags.length > 0 && (
        <div class="flex gap-2 flex-wrap mb-6">
          {resource.data.tags.map((tag) => <Badge>{tag}</Badge>)}
        </div>
      )}
      <h1 class="font-display text-4xl font-semibold text-ink mb-6">{resource.data.title}</h1>
      <p class="text-ink-muted text-lg mb-10">{resource.data.description}</p>
      <div class="prose prose-lg max-w-none prose-headings:font-display">
        <Content />
      </div>
      <div class="mt-16 pt-8 border-t border-ink-border">
        <Button href="/reserva" variant="primary">Reservar cita</Button>
        <Button href="/recursos" variant="ghost" class="ml-4">← Volver a recursos</Button>
      </div>
    </article>
  </Container>
</Layout>
