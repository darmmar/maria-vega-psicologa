---
import Layout from '@/components/layout/Layout.astro'
import Container from '@/components/ui/Container.astro'
import Badge from '@/components/ui/Badge.astro'
import Button from '@/components/ui/Button.astro'
import PageHero from '@/components/ui/PageHero.astro'
import { render } from 'astro:content'
import ProseWrapper from '@/components/ui/ProseWrapper.astro'
import { getPublishedResources } from '@/lib/content/collections'
import { buildArticle, buildBreadcrumbList, buildJsonLdGraph, buildPerson } from '@/lib/seo'

// Componentes dinámicos de TinaCMS para el editor de bloques ricos
import BotonCTA from "@/components/cms/BotonCTA.astro";
import Testimonio from "@/components/cms/Testimonio.astro";
import Acordeon from "@/components/cms/Acordeon.astro";
import Alerta from "@/components/cms/Alerta.astro";

export async function getStaticPaths() {
  const resources = await getPublishedResources()
  return resources.map((r) => ({
    params: { slug: r.data.slug },
    props: { resource: r },
  }))
}

const { resource } = Astro.props
const { Content } = await render(resource)

const rawTitle = resource.data.seoTitle ?? resource.data.title
const pageTitle = rawTitle.includes(":") ? rawTitle.split(":")[0].trim() : rawTitle
const pageUrl = `/recursos/${resource.data.slug}`

const jsonLd = buildJsonLdGraph(
  buildPerson(),
  buildArticle({
    title: resource.data.title,
    description: resource.data.description,
    url: pageUrl,
    datePublished: resource.data.publishedAt,
    dateModified: resource.data.dateModified,
    image: resource.data.image,
    tags: resource.data.tags,
  }),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: "Recursos", url: "/recursos" },
    { name: resource.data.title, url: pageUrl },
  ])
)
---
<Layout
  title={pageTitle}
  description={resource.data.seoDescription ?? resource.data.description}
  canonical={pageUrl}
  jsonLd={jsonLd}
  ogType="article"
  publishedTime={resource.data.publishedAt}
>
  <PageHero
    title={resource.data.title}
    description={resource.data.description}
    align="left"
    maxWidth="2xl"
  />

  <section class="section-gap-tight">
    <Container>
      <article class="max-w-2xl mx-auto animate-fade-in-up">
        {resource.data.tags.length > 0 && (
          <div class="flex gap-2 flex-wrap mb-6">
            {resource.data.tags.map((tag) => <Badge variant="blush">{tag}</Badge>)}
          </div>
        )}
        <ProseWrapper>
          <Content components={{ BotonCTA, Testimonio, Acordeon, Alerta }} />
        </ProseWrapper>
        <div class="mt-16 pt-8 border-t border-ink-border/10">
          <Button href="/recursos" variant="ghost">← Volver a recursos</Button>
        </div>
      </article>
    </Container>
  </section>
</Layout>

