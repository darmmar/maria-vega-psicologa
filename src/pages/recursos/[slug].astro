---
export const prerender = false;
import ResourcePage from "@/components/tina/ResourcePage.astro";
import { hasDocument } from "@/lib/content/collections";
const slug = Astro.params.slug!;
if (!(await hasDocument("resources", slug, Boolean(Astro.locals.tinaEdit)))) return Astro.redirect("/404");
---
<ResourcePage slug={slug} />
