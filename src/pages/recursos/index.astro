---
import Layout from '@/components/layout/Layout.astro'
import Container from '@/components/ui/Container.astro'
import Card from '@/components/ui/Card.astro'
import Badge from '@/components/ui/Badge.astro'
import PageHero from '@/components/ui/PageHero.astro'
import { getPublishedResources } from '@/lib/content/collections'

const resources = await getPublishedResources()
---
<Layout title="Recursos" description="Artículos y recursos psicoeducativos sobre ansiedad, duelo, terapia y bienestar emocional." canonical="/recursos">
  <PageHero
    label="Recursos"
    title="Recursos psicoeducativos"
    description="Artículos para entender mejor el malestar emocional y el proceso terapéutico."
    maxWidth="3xl"
  />

  <section class="section-gap-tight">
    <Container>
      {resources.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in-up">
          {resources.map((r) => (
            <Card class="flex flex-col h-full transition-all duration-300">
              <div class="flex flex-col h-full justify-between">
                <div>
                  {r.data.tags.length > 0 && (
                    <div class="mb-3">
                      <Badge variant="blush">{r.data.tags[0]}</Badge>
                    </div>
                  )}
                  <h2 class="font-display text-xl font-normal text-ink mb-2 line-clamp-2 h-14 leading-snug">
                    {r.data.title}
                  </h2>
                  <p class="text-ink-muted text-sm mb-4 font-body line-clamp-3">
                    {r.data.description}
                  </p>
                </div>
                
                <div class="pt-2">
                  <a href={`/recursos/${r.data.slug}`} class="text-sage font-medium text-sm hover:underline font-body inline-flex items-center gap-1">
                    Leer <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
                  </a>
                </div>
              </div>
            </Card>
          ))}
        </div>
      ) : (
        <p class="text-center text-ink-muted py-12 font-body">Próximamente recursos psicoeducativos.</p>
      )}
    </Container>
  </section>
</Layout>

