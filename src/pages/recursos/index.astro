---
import Layout from '@/components/layout/Layout.astro'
import Container from '@/components/ui/Container.astro'
import Badge from '@/components/ui/Badge.astro'
import PageHero from '@/components/ui/PageHero.astro'
import { getPublishedResources } from '@/lib/content/collections'
import { buildBreadcrumbList, buildJsonLdGraph, buildPerson } from '@/lib/seo'

const resources = await getPublishedResources()

const jsonLd = buildJsonLdGraph(
  buildPerson(),
  {
    "@type": "CollectionPage",
    name: "Recursos psicoeducativos",
    description: "Artículos y recursos psicoeducativos sobre ansiedad, duelo, terapia y bienestar emocional.",
    url: "/recursos",
    inLanguage: "es-ES",
  },
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: "Recursos", url: "/recursos" },
  ])
)
---
<Layout title="Recursos psicoeducativos" description="Artículos y recursos psicoeducativos sobre ansiedad, duelo, terapia y bienestar emocional." canonical="/recursos" jsonLd={jsonLd}>
  <PageHero
    label="Recursos"
    title="Recursos psicoeducativos"
    description="Artículos para entender mejor el malestar emocional y el proceso terapéutico."
    maxWidth="3xl"
  />

  <section class="section-gap-tight">
    <Container>
      {resources.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in-up">
          {resources.map((r) => (
            <a
              href={`/recursos/${r.data.slug}`}
              aria-label={`Leer artículo: ${r.data.title}`}
              class="group block p-6 bg-white rounded-2xl border border-ink-border/30 shadow-premium hover:border-sage/20 hover:shadow-premium-hover hover:-translate-y-1 transition-all duration-300 ease-out flex flex-col justify-between"
            >
              <div>
                {r.data.tags.length > 0 && (
                  <div class="mb-3">
                    <Badge variant="blush">{r.data.tags[0]}</Badge>
                  </div>
                )}
                <h2 class="font-display text-xl font-normal text-ink mb-2 line-clamp-2 h-14 leading-snug group-hover:text-sage transition-colors duration-200">
                  {r.data.title}
                </h2>
                <p class="text-ink-muted text-sm mb-4 font-body line-clamp-3">
                  {r.data.description}
                </p>
              </div>
              
              <div class="pt-3 border-t border-ink-border/10">
                <span class="text-sage font-medium text-sm group-hover:underline underline-offset-4 font-body inline-flex items-center gap-1">
                  Leer artículo <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-center text-ink-muted py-12 font-body">Próximamente recursos psicoeducativos.</p>
      )}
    </Container>
  </section>
</Layout>

