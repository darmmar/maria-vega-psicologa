---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { getContactPage, getSiteSettings } from "@/lib/content/collections";
import { buildBreadcrumbList, buildJsonLdGraph, buildMedicalBusiness, buildPerson } from "@/lib/seo";
import { Icon } from "astro-icon/components";

const [page, settings] = await Promise.all([
  getContactPage(),
  getSiteSettings(),
]);
const { hero, firstConsultation, contactDetails, formSection } = page;
const { email, whatsapp, telegram, phone } = settings.contact;

// Fuente única de verdad (SSOT): dirección y mapa configurados en Ajustes Globales
const displayAddress = settings.legal.address || "Calle Zamarrilla 15, Málaga";
const googleMapsEmbedUrl =
  settings.contact.googleMapsEmbedUrl ||
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3198.08511972357!2d-4.437210208017739!3d36.720516900770114!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd72f7e7348ace0d%3A0x7a0ce8d243927971!2sMar%C3%ADa%20Vega%20Psicolog%C3%ADa!5e0!3m2!1ses!2ses!4v1788714589042!5m2!1ses!2ses";

const googleMapsLink =
  settings.contact.googleMapsLink ||
  `https://maps.google.com/?q=${encodeURIComponent(displayAddress)}`;

const mapCardTitle = contactDetails.mapCardTitle || "Consulta presencial";
const mapNote = contactDetails.mapNote || "Atención exclusivamente con cita previa.";

const pageTitle = page.seoTitle;
const pageDescription = page.seoDescription;

// Datos estructurados (NAP consistente con Schema.org LocalBusiness y Person)
const businessOverrides = {
  address: settings.legal.address,
  phone: settings.contact.phone,
  email: settings.contact.email,
  googleMapsLink: settings.contact.googleMapsLink,
  collegiateNumber: settings.legal.collegiateNumber,
  businessName: settings.legal.businessName,
  instagram: settings.contact.instagram,
  linkedin: settings.contact.linkedin,
};

const jsonLd = buildJsonLdGraph(
  buildMedicalBusiness(businessOverrides),
  buildPerson({ description: pageDescription, overrides: businessOverrides }),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: hero.title, url: "/contacto" },
  ]),
);
---

<Layout title={pageTitle} description={pageDescription} canonical="/contacto" jsonLd={jsonLd}>
  <PageHero
    label={hero.label}
    title={hero.title}
    description={hero.intro}
    maxWidth="4xl"
  />

  <section class="section-gap-tight bg-gradient-to-b from-warm-50/20 to-warm-100/10">
    <Container>
      <div class="max-w-5xl mx-auto animate-fade-in-up">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">
          
          {/* Columna Izquierda: Aviso de Cita, Datos de Contacto y Mapa */}
          <div class="space-y-6 lg:col-span-5">
            
            {/* Aviso sutil y directo al calendario de reservas */}
            <div class="p-4 sm:p-5 rounded-2xl bg-sage/5 border border-sage/15 transition-all hover:bg-sage/10">
              <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-xl bg-sage/10 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                  <Icon name="lucide:calendar-check" class="w-4 h-4" />
                </div>
                <div class="space-y-1 text-sm font-body">
                  <p class="font-medium text-ink">¿Prefieres agendar directamente?</p>
                  <p class="text-ink-muted text-xs sm:text-sm leading-relaxed">
                    Si deseas reservar tu sesión ahora mismo sin esperar respuesta, puedes consultar mi disponibilidad en el{" "}
                    <a
                      href={firstConsultation?.calendarCta?.linkHref || "/reserva"}
                      class="text-sage font-semibold underline underline-offset-4 hover:text-sage-700"
                    >
                      {firstConsultation?.calendarCta?.linkLabel || "calendario de citas"}
                    </a>.
                  </p>
                </div>
              </div>
            </div>

            {/* Canales de contacto directo con iconos vectoriales limpios */}
            <div class="p-5 sm:p-6 rounded-2xl bg-white border border-ink-border/20 shadow-sm space-y-4">
              <h3 class="font-display text-lg font-normal text-ink">{contactDetails.title}</h3>
              
              <div class="space-y-4">
                {/* Email */}
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                    <Icon name="lucide:mail" class="w-4 h-4" />
                  </div>
                  <div>
                    <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Email</p>
                    {
                      email ? (
                        <a
                          href={`mailto:${email}`}
                          class="text-ink text-sm hover:text-sage transition-colors font-body font-medium"
                        >
                          {email}
                        </a>
                      ) : (
                        <p class="text-ink-muted italic text-sm font-body">[EMAIL PENDIENTE]</p>
                      )
                    }
                  </div>
                </div>
                
                {/* WhatsApp */}
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                    <Icon name="simple-icons:whatsapp" class="w-4 h-4" />
                  </div>
                  <div>
                    <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">WhatsApp</p>
                    {
                      whatsapp ? (
                        <a
                          href={whatsapp}
                          class="text-ink text-sm hover:text-sage transition-colors font-body font-medium inline-flex items-center gap-1"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Escribir por WhatsApp
                          <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5 text-ink-muted" />
                        </a>
                      ) : (
                        <p class="text-ink-muted italic text-sm font-body">[WHATSAPP PENDIENTE]</p>
                      )
                    }
                  </div>
                </div>

                {/* Teléfono (si está disponible) */}
                {
                  phone && (
                    <div class="flex items-start gap-3">
                      <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                        <Icon name="lucide:phone" class="w-4 h-4" />
                      </div>
                      <div>
                        <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Teléfono</p>
                        <a
                          href={`tel:${phone.replace(/\s+/g, '')}`}
                          class="text-ink text-sm hover:text-sage transition-colors font-body font-medium"
                        >
                          {phone}
                        </a>
                      </div>
                    </div>
                  )
                }

                {/* Ubicación */}
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                    <Icon name="lucide:map-pin" class="w-4 h-4" />
                  </div>
                  <div>
                    <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Ubicación</p>
                    <p class="text-ink text-sm font-body font-medium">{displayAddress}</p>
                  </div>
                </div>

                {/* Telegram (si está configurado) */}
                {
                  telegram && (
                    <div class="flex items-start gap-3">
                      <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                        <Icon name="simple-icons:telegram" class="w-4 h-4" />
                      </div>
                      <div>
                        <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Telegram</p>
                        <a
                          href={telegram}
                          class="text-ink text-sm hover:text-sage transition-colors font-body font-medium"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Escribir por Telegram
                        </a>
                      </div>
                    </div>
                  )
                }
              </div>
            </div>

            {/* Mapa interactivo de Google Maps */}
            <div class="p-5 sm:p-6 rounded-2xl bg-white border border-ink-border/20 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <Icon name="lucide:map" class="w-4 h-4 text-sage" />
                  <h4 class="font-display text-base font-normal text-ink">{mapCardTitle}</h4>
                </div>
                {
                  googleMapsLink && (
                    <a
                      href={googleMapsLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-xs text-sage font-medium hover:text-sage-700 underline underline-offset-2 transition-colors"
                    >
                      <span>Cómo llegar</span>
                      <Icon name="lucide:external-link" class="w-3 h-3" />
                    </a>
                  )
                }
              </div>

              <div class="rounded-xl overflow-hidden border border-ink-border/15 aspect-[16/10] w-full bg-warm-50/50">
                <iframe
                  src={googleMapsEmbedUrl}
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="w-full h-full"
                  title={`Ubicación de ${mapCardTitle}`}
                ></iframe>
              </div>

              {
                mapNote && (
                  <p class="text-xs text-ink-muted leading-relaxed font-body">
                    {mapNote}
                  </p>
                )
              }
            </div>

          </div>

          {/* Columna Derecha: Formulario de Mensaje */}
          <div class="lg:col-span-7 p-6 sm:p-8 rounded-2xl bg-white border border-ink-border/20 shadow-premium">
            <h2 class="font-display text-2xl font-normal text-ink mb-6">{formSection.title}</h2>

            <form class="space-y-5">
              <div>
                <label for="nombre" class="block text-sm font-medium text-ink mb-1.5 font-body">
                  Nombre
                </label>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  required
                  autocomplete="name"
                  class="w-full rounded-xl border border-ink-border/30 bg-white px-4 py-3 text-ink placeholder-ink-muted/50 focus:border-sage focus:outline-none focus:ring-4 focus:ring-sage/10 transition-all duration-200 font-body text-sm"
                  placeholder="Tu nombre"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-ink mb-1.5 font-body">
                  Email
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="w-full rounded-xl border border-ink-border/30 bg-white px-4 py-3 text-ink placeholder-ink-muted/50 focus:border-sage focus:outline-none focus:ring-4 focus:ring-sage/10 transition-all duration-200 font-body text-sm"
                  placeholder="tu@email.com"
                />
              </div>

              <div>
                <label for="mensaje" class="block text-sm font-medium text-ink mb-1.5 font-body">
                  Mensaje
                </label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  required
                  rows={5}
                  class="w-full rounded-xl border border-ink-border/30 bg-white px-4 py-3 text-ink placeholder-ink-muted/50 focus:border-sage focus:outline-none focus:ring-4 focus:ring-sage/10 transition-all duration-200 font-body text-sm resize-none"
                  placeholder="¿En qué puedo ayudarte?"
                ></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input
                  id="privacidad"
                  name="privacidad"
                  type="checkbox"
                  required
                  class="mt-1 h-4 w-4 rounded border-ink-border/40 text-sage focus:ring-sage"
                />
                <label for="privacidad" class="text-sm text-ink-muted leading-relaxed font-body">
                  He leído la{" "}
                  <a
                    href="/legal/privacidad"
                    class="text-sage underline underline-offset-4 hover:text-sage-600"
                  >
                    política de privacidad
                  </a>{" "}
                  y consiento el tratamiento de mis datos para atender mi consulta.
                </label>
              </div>

              <p class="text-xs text-ink-muted/70 leading-relaxed border-l-2 border-ink-border/20 pl-3 font-body">
                {formSection.privacyNote}
              </p>

              <button
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2 font-body font-medium rounded-lg bg-sage text-white px-6 py-3.5 text-base hover:bg-sage-600 hover:shadow-premium hover:-translate-y-0.5 active:translate-y-0 active:shadow-none transition-all duration-300 ease-out focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2"
              >
                {formSection.submitLabel}
              </button>
            </form>
          </div>

        </div>
      </div>
    </Container>
  </section>
</Layout>
