---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { getContactPage, getSiteSettings } from "@/lib/content/collections";
import { buildBreadcrumbList, buildJsonLdGraph, buildPerson } from "@/lib/seo";
import { Icon } from "astro-icon/components";

const [page, settings] = await Promise.all([
  getContactPage(),
  getSiteSettings(),
]);
const { hero, firstConsultation, contactDetails, formSection } = page;
const { email, whatsapp, telegram, tiktok, linkedin } = settings.contact;

const pageTitle = page.seoTitle;
const pageDescription = page.seoDescription;

const jsonLd = buildJsonLdGraph(
  buildPerson({ description: pageDescription }),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: hero.title, url: "/contacto" },
  ]),
);
---

<Layout title={pageTitle} description={pageDescription} canonical="/contacto" jsonLd={jsonLd}>
  <PageHero
    label={hero.label}
    title={hero.title}
    description={hero.intro}
    maxWidth="4xl"
  />

  <section class="section-gap-tight bg-gradient-to-b from-warm-50/20 to-warm-100/10">
    <Container>
      <div class="max-w-4xl mx-auto animate-fade-in-up">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="space-y-8 lg:col-span-5">
            <div>
              <h2 class="font-display text-2xl font-medium text-ink mb-4 leading-snug">
                {firstConsultation.title}
              </h2>
              {
                firstConsultation.paragraphs.map((paragraph) => (
                  <p class="text-ink-muted leading-relaxed mb-3 font-body">{paragraph}</p>
                ))
              }
              <p class="text-ink-muted leading-relaxed mt-4 font-body">
                {firstConsultation.calendarCta.prefix}
                <a
                  href={firstConsultation.calendarCta.linkHref}
                  class="text-sage font-medium underline underline-offset-4 hover:text-sage-600"
                >
                  {firstConsultation.calendarCta.linkLabel}
                </a>
                {firstConsultation.calendarCta.suffix}
              </p>
            </div>

            <div class="space-y-4 pt-6 border-t border-ink-border/10">
              <h3 class="font-display text-lg font-medium text-ink">{contactDetails.title}</h3>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                    <Icon name="lucide:mail" class="w-4 h-4" />
                  </div>
                  <div>
                    <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Email</p>
                    {
                      email ? (
                        <a
                          href={`mailto:${email}`}
                          class="text-ink-muted text-sm hover:text-sage transition-colors font-body"
                        >
                          {email}
                        </a>
                      ) : (
                        <p class="text-ink-muted italic text-sm font-body">[EMAIL PENDIENTE]</p>
                      )
                    }
                  </div>
                </div>
                
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                    <Icon name="simple-icons:whatsapp" class="w-4 h-4" />
                  </div>
                  <div>
                    <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">WhatsApp</p>
                    {
                      whatsapp ? (
                        <a
                          href={whatsapp}
                          class="text-ink-muted text-sm hover:text-sage transition-colors font-body"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Escribir por WhatsApp
                        </a>
                      ) : (
                        <p class="text-ink-muted italic text-sm font-body">[WHATSAPP PENDIENTE]</p>
                      )
                    }
                  </div>
                </div>
                
                {
                  telegram && (
                    <div class="flex items-start gap-3">
                      <div class="w-8 h-8 rounded-lg bg-sage/5 flex items-center justify-center text-sage flex-shrink-0 mt-0.5" aria-hidden="true">
                        <Icon name="simple-icons:telegram" class="w-4 h-4" />
                      </div>
                      <div>
                        <p class="text-[10px] label-caps text-ink-muted mb-0.5 tracking-wider">Telegram</p>
                        <a
                          href={telegram}
                          class="text-ink-muted text-sm hover:text-sage transition-colors font-body"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Escribir por Telegram
                        </a>
                      </div>
                    </div>
                  )
                }


              </div>
            </div>
          </div>

          <div class="lg:col-span-7 p-6 sm:p-8 rounded-2xl bg-white border border-ink-border/20 shadow-premium">
            <h2 class="font-display text-2xl font-medium text-ink mb-6">{formSection.title}</h2>

            {/* TODO: conectar formulario a un servicio de email (Resend, Formspree, etc.) */}
            <form class="space-y-5">
              <div>
                <label for="nombre" class="block text-sm font-medium text-ink mb-1.5 font-body">
                  Nombre
                </label>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  required
                  autocomplete="name"
                  class="w-full rounded-xl border border-ink-border/30 bg-white px-4 py-3 text-ink placeholder-ink-muted/50 focus:border-sage focus:outline-none focus:ring-4 focus:ring-sage/10 transition-all duration-200 font-body text-sm"
                  placeholder="Tu nombre"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-ink mb-1.5 font-body">
                  Email
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="w-full rounded-xl border border-ink-border/30 bg-white px-4 py-3 text-ink placeholder-ink-muted/50 focus:border-sage focus:outline-none focus:ring-4 focus:ring-sage/10 transition-all duration-200 font-body text-sm"
                  placeholder="tu@email.com"
                />
              </div>

              <div>
                <label for="mensaje" class="block text-sm font-medium text-ink mb-1.5 font-body">
                  Mensaje
                </label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  required
                  rows={5}
                  class="w-full rounded-xl border border-ink-border/30 bg-white px-4 py-3 text-ink placeholder-ink-muted/50 focus:border-sage focus:outline-none focus:ring-4 focus:ring-sage/10 transition-all duration-200 font-body text-sm resize-none"
                  placeholder="¿En qué puedo ayudarte?"
                ></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input
                  id="privacidad"
                  name="privacidad"
                  type="checkbox"
                  required
                  class="mt-1 h-4 w-4 rounded border-ink-border/40 text-sage focus:ring-sage"
                />
                <label for="privacidad" class="text-sm text-ink-muted leading-relaxed font-body">
                  He leído la
                  <a
                    href="/legal/privacidad"
                    class="text-sage underline underline-offset-4 hover:text-sage-600"
                  >
                    política de privacidad
                  </a>
                  y consiento el tratamiento de mis datos para atender mi consulta.
                </label>
              </div>

              <p class="text-xs text-ink-muted/70 leading-relaxed border-l-2 border-ink-border/20 pl-3 font-body">
                {formSection.privacyNote}
              </p>

              <button
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2 font-body font-medium rounded-lg bg-sage text-white px-6 py-3.5 text-base hover:bg-sage-600 hover:shadow-premium hover:-translate-y-0.5 active:translate-y-0 active:shadow-none transition-all duration-300 ease-out focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2"
              >
                {formSection.submitLabel}
              </button>
            </form>
          </div>
        </div>

        <!-- Google Maps & Consultation Section -->
        <div class="mt-16 pt-12 border-t border-ink-border/10">
          <div class="grid md:grid-cols-12 gap-8 items-center">
            <div class="md:col-span-5 space-y-4">
              <h3 class="font-display text-2xl font-medium text-ink">Consulta presencial</h3>
              <p class="text-ink-muted leading-relaxed font-body text-sm">
                Si prefieres realizar las sesiones presencialmente, puedes acudir a mi consulta en Málaga. Un espacio cómodo, tranquilo y confidencial diseñado para tu bienestar.
              </p>
              <div class="space-y-1.5 pt-2">
                <p class="font-medium text-ink font-body text-sm">Dirección de la consulta:</p>
                <p class="text-ink-muted font-body text-sm">{settings.legal.address || 'Málaga, España'}</p>
              </div>
              {
                settings.contact.googleMapsLink && (
                  <div class="pt-2">
                    <a
                      href={settings.contact.googleMapsLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-sage hover:text-sage-600 font-medium text-sm underline underline-offset-4"
                    >
                      <Icon name="lucide:map-pin" class="w-4 h-4" />
                      Cómo llegar en Google Maps
                    </a>
                  </div>
                )
              }
            </div>
            <div class="md:col-span-7">
              {
                settings.contact.googleMapsEmbedUrl ? (
                  <div class="rounded-2xl overflow-hidden border border-ink-border/20 shadow-premium h-72 w-full bg-warm-50/50">
                    <iframe
                      src={settings.contact.googleMapsEmbedUrl}
                      width="100%"
                      height="100%"
                      style="border:0;"
                      allowfullscreen=""
                      loading="lazy"
                      referrerpolicy="no-referrer-when-downgrade"
                      class="w-full h-full"
                    ></iframe>
                  </div>
                ) : (
                  <div class="rounded-2xl border border-dashed border-ink-border/30 bg-warm-50/20 p-8 text-center flex flex-col items-center justify-center h-72">
                    <Icon name="lucide:map" class="w-8 h-8 text-ink-muted/40 mb-3" />
                    <p class="text-sm font-medium text-ink-muted font-body">Consulta presencial en Málaga</p>
                    <p class="text-xs text-ink-faint mt-1 max-w-xs mx-auto">Puedes consultar el mapa interactivo o configurarlo en los ajustes del panel de control.</p>
                  </div>
                )
              }
            </div>
          </div>
        </div>

      </div>
    </Container>
  </section>
</Layout>

