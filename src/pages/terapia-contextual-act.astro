---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import CTASection from "@/components/sections/CTASection.astro";
---

<Layout
  title="Terapia Contextual ACT"
  description="Terapia de Aceptación y Compromiso (ACT). Enfoque de tercera generación basado en evidencia para mejorar tu bienestar psicológico."
>
  <section class="py-16">
    <Container>
      <h1 class="mb-6 text-4xl font-bold text-gray-900">
        Terapia contextual y ACT (Aceptación y Compromiso)
      </h1>
      <p class="text-lg text-gray-600">Contenido en construcción.</p>
    </Container>
  </section>
  <CTASection />
</Layout>
