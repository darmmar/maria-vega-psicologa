---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import ExperienceBlock from "@/components/sections/ExperienceBlock.astro";
import TrainingBlock from "@/components/sections/TrainingBlock.astro";
import CTASection from "@/components/sections/CTASection.astro";
---

<Layout
  title="Conóceme"
  description="Conoce a María Vega, psicóloga general sanitaria en Málaga. Formación, experiencia y enfoque terapéutico basado en evidencia."
>
  <section class="py-16">
    <Container>
      <h1 class="mb-6 text-4xl font-bold text-gray-900">Conóceme</h1>
      <p class="text-lg text-gray-600">Contenido en construcción.</p>
    </Container>
  </section>
  <ExperienceBlock />
  <TrainingBlock />
  <CTASection />
</Layout>
