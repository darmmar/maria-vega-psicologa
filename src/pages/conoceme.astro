---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import ExperienceBlock from "@/components/sections/ExperienceBlock.astro";
import TrainingBlock from "@/components/sections/TrainingBlock.astro";
import CTASection from "@/components/sections/CTASection.astro";
import SectionDivider from "@/components/ui/SectionDivider.astro";
import { Icon } from "astro-icon/components";
import { buildBreadcrumbList, buildJsonLdGraph, buildPerson } from "@/lib/seo";
import { getProfile } from "@/lib/content/collections";
import { imageSrc } from "@/lib/images";

const profile = await getProfile();
const { hero, approach, cta } = profile;
const photoSrc = imageSrc(hero.photo);
const secondaryPhotoSrc = imageSrc(hero.secondaryPhoto);
const secondaryPhotoAlt = hero.secondaryPhotoAlt?.trim() || hero.photoAlt;

const jsonLd = buildJsonLdGraph(
  buildPerson({
    description:
      "Conoce a María Vega, psicóloga general sanitaria en Málaga. Terapia contextual, ACT y perspectiva de género basada en evidencia científica.",
  }),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: "Conóceme", url: "/conoceme" },
  ]),
);
---

<Layout
  title="Conóceme"
  description="Conoce a María Vega, psicóloga general sanitaria en Málaga. Terapia contextual, ACT y perspectiva de género basada en evidencia científica."
  canonical="/conoceme"
  jsonLd={jsonLd}
>
  <section class="section-hero bg-[#f6f3ef] border-b border-[#e9e4de] relative overflow-hidden">
    <Container class="relative">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center animate-fade-in-up">
        <div class="lg:col-span-7">
          <p class="label-caps text-sage mb-4">{hero.label}</p>
          <h1 class="font-display text-4xl lg:text-5xl font-normal text-ink mb-6 leading-tight">
            {hero.title}
          </h1>
          {
            hero.intro.map((paragraph) => (
              <p class="text-ink-muted text-lg leading-relaxed mb-4 last:mb-0 font-body">{paragraph}</p>
            ))
          }
        </div>

        <div class="lg:col-span-5 space-y-5 w-full max-w-xs mx-auto lg:mx-0">
          {
            photoSrc ? (
              <figure class="relative group">
                <img
                  src={photoSrc}
                  alt={hero.photoAlt}
                  class="aspect-[3/4] w-full rounded-2xl object-cover border border-ink-border/20 shadow-premium transition-transform duration-500 hover:scale-[1.01]"
                  loading="eager"
                  decoding="async"
                />
              </figure>
            ) : (
              <div
                class="aspect-[3/4] w-full rounded-2xl bg-warm-200/50 flex flex-col items-center justify-center border border-warm-300 gap-3 shadow-premium"
                aria-hidden="true"
              >
                <Icon name="lucide:user" class="w-16 h-16 text-warm-500 opacity-60" aria-hidden="true" />
                <p class="text-ink-muted text-sm font-body text-center px-6">{hero.photoPlaceholder}</p>
              </div>
            )
          }

          {
            secondaryPhotoSrc ? (
              <figure class="relative group">
                <img
                  src={secondaryPhotoSrc}
                  alt={secondaryPhotoAlt}
                  class="aspect-[4/3] w-full rounded-2xl object-cover border border-ink-border/10 shadow-premium"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ) : null
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="section-gap-tight">
    <Container>
      <div class="max-w-4xl animate-fade-in-up">
        <span class="label-caps text-sage block mb-4">{approach.label}</span>
        <h2 class="font-display text-3xl lg:text-4xl font-normal text-ink mb-8 leading-tight">
          {approach.title}
        </h2>

        <div class="space-y-5 text-ink-muted text-lg leading-relaxed font-body border-l-2 border-sage/20 pl-8">
          {approach.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </Container>
  </section>

  <SectionDivider />
  <TrainingBlock />
  <SectionDivider />
  <ExperienceBlock />
  <SectionDivider />

  <CTASection
    title={cta.title}
    description={cta.description}
    ctaLabel={cta.label}
    ctaHref={cta.href}
  />
</Layout>

