---
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CTASection from "@/components/sections/CTASection.astro";
import Button from "@/components/ui/Button.astro";
import DynamicIcon from "@/components/ui/DynamicIcon.astro";
import { Icon } from "astro-icon/components";
import { getPublishedServices, getServicesPage, getSiteSettings } from "@/lib/content/collections";
import { imageSrc } from "@/lib/images";
import { buildBreadcrumbList, buildJsonLdGraph, buildMedicalBusiness, buildPerson } from "@/lib/seo";

const [settings, servicesPage, allServices] = await Promise.all([
  getSiteSettings(),
  getServicesPage(),
  getPublishedServices(),
]);

// Separar modalidades (formato) de especialidades clínicas (motivos de consulta)
const modalitySlugs = ["terapia-presencial", "terapia-online"];
const clinicalSpecialties = allServices.filter((s) => !modalitySlugs.includes(s.data.slug));

const pageTitle = servicesPage.seoTitle;
const pageDescription = servicesPage.seoDescription;

const businessOverrides = {
  address: settings.legal.address,
  phone: settings.contact.phone,
  email: settings.contact.email,
  googleMapsLink: settings.contact.googleMapsLink,
  collegiateNumber: settings.legal.collegiateNumber,
  businessName: settings.legal.businessName,
  instagram: settings.contact.instagram,
  linkedin: settings.contact.linkedin,
};

const jsonLd = buildJsonLdGraph(
  buildMedicalBusiness(businessOverrides),
  buildPerson({ overrides: businessOverrides }),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: "Servicios", url: "/servicios" },
  ])
);
---

<Layout title={pageTitle} description={pageDescription} canonical="/servicios" jsonLd={jsonLd}>
  <PageHero
    label={servicesPage.hero.label}
    title={servicesPage.hero.title}
    description={servicesPage.hero.description}
    maxWidth="3xl"
  />

  <!-- 1. BLOQUE DESTACADO: MODALIDADES DE ATENCIÓN (Presencial vs Online) -->
  <section class="section-gap-tight bg-gradient-to-b from-warm-100/60 to-warm-200/30 border-b border-ink-border/30">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="label-caps text-sage block mb-2">{servicesPage.modalitiesSection.label}</span>
        <h2 class="font-display text-2xl lg:text-3xl font-normal text-ink">
          {servicesPage.modalitiesSection.title}
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl lg:max-w-[1080px] mx-auto">
        {
          servicesPage.modalitiesSection.items.map((item) => (
            <div class="relative p-7 sm:p-8 bg-white rounded-3xl border border-sage/30 shadow-premium hover:shadow-premium-hover transition-all duration-300 flex flex-col justify-between group">
              {item.badge && (
                <div class="absolute top-4 right-4 bg-sage/10 text-sage text-xs font-semibold px-3 py-1 rounded-full">
                  {item.badge}
                </div>
              )}
              <div>
                <div class="w-12 h-12 rounded-2xl bg-sage/10 text-sage flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                  <DynamicIcon name={item.icon} class="w-6 h-6" />
                </div>
                <h3 class="font-display text-2xl font-normal text-ink mb-3">
                  {item.title}
                </h3>
                <p class="text-ink-muted text-sm sm:text-base leading-relaxed mb-6 font-body">
                  {item.description}
                </p>
                <div class="space-y-2 mb-8 text-xs sm:text-sm text-ink-muted font-body">
                  <div class="flex items-center gap-2">
                    <Icon name="lucide:clock" class="w-4 h-4 text-sage flex-shrink-0" />
                    <span>{item.schedule}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <DynamicIcon name={item.featureIcon} class="w-4 h-4 text-sage flex-shrink-0" />
                    <span>{item.feature}</span>
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                <Button
                  href={item.primaryButtonHref}
                  size="md"
                  class="w-full text-center justify-center whitespace-nowrap px-4 text-sm sm:text-base font-medium"
                >
                  {item.primaryButtonText}
                </Button>
                <Button
                  href={item.secondaryButtonHref}
                  variant="secondary"
                  size="md"
                  class="w-full text-center justify-center whitespace-nowrap px-4 text-sm sm:text-base font-medium"
                >
                  {item.secondaryButtonText}
                </Button>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- 2. BLOQUE: ÁREAS DE ACOMPAÑAMIENTO (¿En qué puedo ayudarte?) -->
  <section class="section-gap">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="label-caps text-sage block mb-3">{servicesPage.specialtiesSection.label}</span>
        <h2 class="font-display text-3xl lg:text-4xl font-normal text-ink">
          {servicesPage.specialtiesSection.title}
        </h2>
        <p class="text-ink-muted mt-3 font-body">
          {servicesPage.specialtiesSection.description}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          clinicalSpecialties.map((service) => {
            const thumbnailSrc = imageSrc(service.data.thumbnail);
            const thumbnailAlt =
              service.data.thumbnailAlt?.trim() || `Miniatura del servicio ${service.data.title}`;

            return (
              <a
                href={`/${service.data.slug}`}
                aria-label={`Saber más sobre ${service.data.title}`}
                class="group block p-6 bg-gradient-to-b from-white to-warm-50/30 rounded-2xl border border-ink-border/30 border-t-2 border-t-sage/25 shadow-premium hover:border-sage/20 hover:shadow-premium-hover hover:-translate-y-1 transition-all duration-300 ease-out flex flex-col justify-between"
              >
                <div>
                  {thumbnailSrc ? (
                    <div class="w-full h-32 overflow-hidden rounded-xl mb-5">
                      <img
                        src={thumbnailSrc}
                        alt={thumbnailAlt}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <div class="w-10 h-10 rounded-xl bg-sage/5 flex items-center justify-center mb-5 text-sage transition-colors duration-300">
                      <DynamicIcon name={service.data.icon} class="w-5 h-5" />
                    </div>
                  )}
                  <h3 class="font-display text-xl font-normal text-ink mb-2 group-hover:text-sage transition-colors duration-200">
                    {service.data.title}
                  </h3>
                  <p class="text-sm text-ink-muted leading-relaxed mb-4 font-body">
                    {service.data.shortDescription}
                  </p>
                </div>
                <div class="pt-3 border-t border-ink-border/10">
                  <span class="text-sm font-medium text-sage group-hover:underline underline-offset-4 font-body inline-flex items-center gap-1">
                    Saber más <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </Container>
  </section>

  <CTASection
    title={settings.cta.title}
    description={settings.cta.description}
    ctaLabel={settings.cta.label}
    ctaHref={settings.cta.href}
  />
</Layout>
