---
export const prerender = false;
import Layout from "@/components/layout/Layout.astro";
import Container from "@/components/ui/Container.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CTASection from "@/components/sections/CTASection.astro";
import Button from "@/components/ui/Button.astro";
import DynamicIcon from "@/components/ui/DynamicIcon.astro";
import { Icon } from "astro-icon/components";
import { tinaField } from "@tinacms/astro";
import { getPublishedServices, getServicesPage, getSiteSettings } from "@/lib/content/collections";
import { imageSrc } from "@/lib/images";
import { buildBreadcrumbList, buildJsonLdGraph, buildMedicalBusiness, buildPerson } from "@/lib/seo";

let [settings, servicesPage, allServices] = await Promise.all([
  getSiteSettings(),
  getServicesPage(),
  getPublishedServices(),
]);

try {
  const { requestWithMetadata } = await import("@tinacms/astro");
  const client = (await import("../../tina/__generated__/client")).default;
  const tinaRes = await requestWithMetadata(
    client.queries.servicesPage({ relativePath: "services.json" }),
    { priority: "primary" }
  );
  if (tinaRes?.data?.servicesPage) {
    servicesPage = tinaRes.data.servicesPage as any;
  }
} catch (e) {
  // Mantener fallback
}

// Separar modalidades (formato) de especialidades clínicas (motivos de consulta)
const modalitySlugs = ["terapia-presencial", "terapia-online"];
const clinicalSpecialties = allServices.filter((s) => !modalitySlugs.includes(s.data.slug));

const pageTitle = servicesPage.seoTitle;
const pageDescription = servicesPage.seoDescription;

const businessOverrides = {
  address: settings.legal.address,
  phone: settings.contact.phone,
  email: settings.contact.email,
  googleMapsLink: settings.contact.googleMapsLink,
  collegiateNumber: settings.legal.collegiateNumber,
  businessName: settings.legal.businessName,
  instagram: settings.contact.instagram,
  linkedin: settings.contact.linkedin,
};

const jsonLd = buildJsonLdGraph(
  buildMedicalBusiness(businessOverrides),
  buildPerson({ overrides: businessOverrides }),
  buildBreadcrumbList([
    { name: "Inicio", url: "/" },
    { name: "Servicios", url: "/servicios" },
  ])
);
---

<Layout title={pageTitle} description={pageDescription} canonical="/servicios" jsonLd={jsonLd}>
  <PageHero
    label={servicesPage.hero.label}
    title={servicesPage.hero.title}
    description={servicesPage.hero.description}
    maxWidth="3xl"
    tinaLabelField={tinaField(servicesPage.hero, "label")}
    tinaTitleField={tinaField(servicesPage.hero, "title")}
    tinaDescriptionField={tinaField(servicesPage.hero, "description")}
  />

  <!-- 1. BLOQUE DESTACADO: MODALIDADES DE ATENCIÓN (Presencial vs Online) -->
  <section class="section-gap-tight bg-gradient-to-b from-warm-100/60 to-warm-200/30 border-b border-ink-border/30">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="label-caps text-sage block mb-2" data-tina-field={tinaField(servicesPage.modalitiesSection, "label")}>{servicesPage.modalitiesSection.label}</span>
        <h2 class="font-display text-2xl lg:text-3xl font-normal text-ink" data-tina-field={tinaField(servicesPage.modalitiesSection, "title")}>
          {servicesPage.modalitiesSection.title}
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl lg:max-w-[1080px] mx-auto">
        {
          servicesPage.modalitiesSection.items.map((item, index) => (
            <div
              class="relative p-7 sm:p-8 bg-white rounded-3xl border border-sage/30 shadow-premium hover:shadow-premium-hover transition-all duration-300 flex flex-col justify-between group"
              data-tina-field={tinaField(servicesPage.modalitiesSection, "items", index)}
            >
              {item.badge && (
                <div
                  class="absolute top-4 right-4 bg-sage/10 text-sage text-xs font-semibold px-3 py-1 rounded-full"
                  data-tina-field={tinaField(item, "badge")}
                >
                  {item.badge}
                </div>
              )}
              <div>
                <div class="w-12 h-12 rounded-2xl bg-sage/10 text-sage flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                  <DynamicIcon name={item.icon} class="w-6 h-6" />
                </div>
                <h3
                  class="font-display text-2xl font-normal text-ink mb-3"
                  data-tina-field={tinaField(item, "title")}
                >
                  {item.title}
                </h3>
                <p
                  class="text-ink-muted text-sm sm:text-base leading-relaxed mb-6 font-body"
                  data-tina-field={tinaField(item, "description")}
                >
                  {item.description}
                </p>
                <div class="space-y-2 mb-8 text-xs sm:text-sm text-ink-muted font-body">
                  <div class="flex items-center gap-2" data-tina-field={tinaField(item, "schedule")}>
                    <Icon name="lucide:clock" class="w-4 h-4 text-sage flex-shrink-0" />
                    <span>{item.schedule}</span>
                  </div>
                  <div class="flex items-center gap-2" data-tina-field={tinaField(item, "feature")}>
                    <DynamicIcon name={item.featureIcon} class="w-4 h-4 text-sage flex-shrink-0" />
                    <span>{item.feature}</span>
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                <Button
                  href={item.primaryButtonHref}
                  external={Boolean(item.primaryButtonHref?.startsWith("http"))}
                  size="md"
                  class="w-full text-center justify-center whitespace-nowrap px-4 text-sm sm:text-base font-medium"
                  data-tina-field={tinaField(item, "primaryButtonText")}
                >
                  {item.primaryButtonText}
                </Button>
                <Button
                  href={item.secondaryButtonHref}
                  variant="secondary"
                  size="md"
                  class="w-full text-center justify-center whitespace-nowrap px-4 text-sm sm:text-base font-medium"
                  data-tina-field={tinaField(item, "secondaryButtonText")}
                >
                  {item.secondaryButtonText}
                </Button>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- 2. BLOQUE: ÁREAS DE ACOMPAÑAMIENTO (¿En qué puedo ayudarte?) -->
  <section class="section-gap">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="label-caps text-sage block mb-3" data-tina-field={tinaField(servicesPage.specialtiesSection, "label")}>{servicesPage.specialtiesSection.label}</span>
        <h2 class="font-display text-3xl lg:text-4xl font-normal text-ink" data-tina-field={tinaField(servicesPage.specialtiesSection, "title")}>
          {servicesPage.specialtiesSection.title}
        </h2>
        <p class="text-ink-muted mt-3 font-body" data-tina-field={tinaField(servicesPage.specialtiesSection, "description")}>
          {servicesPage.specialtiesSection.description}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          (servicesPage.specialtiesSection.items ?? clinicalSpecialties).map((rawService: any, index: number) => {
            const isPageItem = !rawService.data;
            const title = isPageItem ? rawService.title : rawService.data.title;
            const shortDescription = isPageItem ? rawService.shortDescription : rawService.data.shortDescription;
            const slug = isPageItem ? rawService.slug : rawService.data.slug;
            const icon = isPageItem ? rawService.icon : rawService.data.icon;
            const thumbnail = isPageItem ? rawService.thumbnail : rawService.data.thumbnail;
            const thumbnailAltProp = isPageItem ? rawService.thumbnailAlt : rawService.data.thumbnailAlt;

            const thumbnailSrc = imageSrc(thumbnail);
            const thumbnailAlt = thumbnailAltProp?.trim() || `Miniatura del servicio ${title}`;
            const cardField = servicesPage.specialtiesSection.items
              ? tinaField(servicesPage.specialtiesSection, "items", index)
              : undefined;

            return (
              <a
                href={`/${slug}`}
                aria-label={`Saber más sobre ${title}`}
                class="group block p-6 bg-gradient-to-b from-white to-warm-50/30 rounded-2xl border border-ink-border/30 border-t-2 border-t-sage/25 shadow-premium hover:border-sage/20 hover:shadow-premium-hover hover:-translate-y-1 transition-all duration-300 ease-out flex flex-col justify-between"
                data-tina-field={cardField}
              >
                <div>
                  {thumbnailSrc ? (
                    <div class="w-full h-32 overflow-hidden rounded-xl mb-5" data-tina-field={isPageItem ? tinaField(rawService, "thumbnail") : undefined}>
                      <img
                        src={thumbnailSrc}
                        alt={thumbnailAlt}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <div class="w-10 h-10 rounded-xl bg-sage/5 flex items-center justify-center mb-5 text-sage transition-colors duration-300">
                      <DynamicIcon name={icon} class="w-5 h-5" />
                    </div>
                  )}
                  <h3
                    class="font-display text-xl font-normal text-ink mb-2 group-hover:text-sage transition-colors duration-200"
                    data-tina-field={isPageItem ? tinaField(rawService, "title") : undefined}
                  >
                    {title}
                  </h3>
                  <p
                    class="text-sm text-ink-muted leading-relaxed mb-4 font-body"
                    data-tina-field={isPageItem ? tinaField(rawService, "shortDescription") : undefined}
                  >
                    {shortDescription}
                  </p>
                </div>
                <div class="pt-3 border-t border-ink-border/10">
                  <span class="text-sm font-medium text-sage group-hover:underline underline-offset-4 font-body inline-flex items-center gap-1">
                    Saber más <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </Container>
  </section>

  <CTASection
    title={servicesPage.cta?.title ?? settings.cta.title}
    description={servicesPage.cta?.description ?? settings.cta.description}
    ctaLabel={servicesPage.cta?.label ?? settings.cta.label}
    ctaHref={servicesPage.cta?.href ?? settings.cta.href}
    tinaTitleField={servicesPage.cta ? tinaField(servicesPage.cta, "title") : undefined}
    tinaDescriptionField={servicesPage.cta ? tinaField(servicesPage.cta, "description") : undefined}
    tinaCtaLabelField={servicesPage.cta ? tinaField(servicesPage.cta, "label") : undefined}
  />
</Layout>
