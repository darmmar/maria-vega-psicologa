# URL pública del sitio (sin trailing slash).
PUBLIC_SITE_URL=https://mariavegagarcia.es

# TinaCMS Cloud (edición remota en /admin — copiar desde app.tina.io → Project → Tokens)
# Obligatorias en Cloudflare Workers / Pages para que el panel /admin y la edición visual funcionen:
# Client ID en Astro (app.tina.io). NEXT_PUBLIC_TINA_CLIENT_ID también se acepta.
PUBLIC_TINA_CLIENT_ID=
# Token Content / Read-only (NO Search token).
TINA_TOKEN=
# Dejar sin definir en Cloudflare: CF_PAGES_BRANCH / WORKERS_CI_BRANCH detectan la rama.
# Override opcional para builds locales con Tina Cloud:
# PUBLIC_TINA_BRANCH=dev
# Búsqueda en el panel, opcional.
TINA_SEARCH_TOKEN=
# Activar la comprobación remota de esquema durante el build:
# TINA_RUN_CLOUD_CHECKS=1

# Solo runtime en Cloudflare Preview, para el botón de publicación existente.
GITHUB_DISPATCH_TOKEN=

# Cal.com (opcional si se sobreescribe desde settings.json)
PUBLIC_CALCOM_URL=

# Stripe Payment Link (opcional si se sobreescribe desde settings.json)
PUBLIC_STRIPE_COURSE_PAYMENT_LINK=
