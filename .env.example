# URL pública del sitio (sin trailing slash)
PUBLIC_SITE_URL=

# URL del perfil de Cal.com (opcional: site.ts usa https://cal.com/maria-vega por defecto)
PUBLIC_CALCOM_URL=https://cal.com/maria-vega

# Stripe Payment Link del curso de duelo (obligatorio para mostrar botón de pago en /curso-duelo)
# Crear en https://dashboard.stripe.com/payment-links y pegar la URL pública (buy.stripe.com/...)
PUBLIC_STRIPE_COURSE_PAYMENT_LINK=

# Email de contacto visible en el sitio
PUBLIC_CONTACT_EMAIL=

# URL del perfil de WhatsApp (wa.me/...)
PUBLIC_WHATSAPP_URL=

# URL del perfil de Instagram
PUBLIC_INSTAGRAM_URL=

# TinaCMS Cloud (solo necesario para edición remota)
# TINA_CLIENT_ID=
# TINA_TOKEN=
# GITHUB_BRANCH=
