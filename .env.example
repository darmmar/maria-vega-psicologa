# URL pública del sitio (sin trailing slash).
PUBLIC_SITE_URL=https://mariavegapsicologia.es

# TinaCMS Cloud (edición remota en /admin — copiar desde app.tina.io → Project → Tokens)
# Obligatorias en Cloudflare Pages para que `pnpm build` genere el panel /admin en producción:
NEXT_PUBLIC_TINA_CLIENT_ID=   # Client ID (app.tina.io)
TINA_TOKEN=                   # Content / Read-only token
TINA_SEARCH_TOKEN=            # Search token (búsqueda en el panel /admin)
GITHUB_BRANCH=main            # Rama de producción

# Cal.com (opcional si se sobreescribe desde settings.json)
PUBLIC_CALCOM_URL=

# Stripe Payment Link (opcional si se sobreescribe desde settings.json)
PUBLIC_STRIPE_COURSE_PAYMENT_LINK=
